[?2004l"""Who may approve what.

policy/owners.json is the source of truth for resource ownership. It is
changed only through a reviewed PR to this repository (CODEOWNERS: security).

    {"resources": {"<resource>": {"owners": [...], "roles": [...], "max_days": N}}}
"""

import json
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path


class PolicyError(Exception):
    pass


@dataclass(frozen=True)
class Resource:
    name: str
    owners: frozenset[str]
    roles: tuple[str, ...]
    max_days: int


@dataclass(frozen=True)
class Decision:
    approved: bool
    reason: str
    approved_by: str | None = None
    on_behalf_of: str | None = None


@dataclass(frozen=True)
class Delegation:
    owner: str
    delegate: str
    resources: frozenset[str]
    starts_at: datetime
    ends_at: datetime


class Policy:
    def __init__(self, resources: dict[str, Resource],
                 delegations: tuple[Delegation, ...] = ()):
        self.resources = resources
        self.delegations = delegations

    @classmethod
    def load(cls, policy_dir: Path) -> "Policy":
        policy_dir = Path(policy_dir)
        doc = json.loads((policy_dir / "owners.json").read_text(encoding="utf-8"))
        resources = {}
        for name, spec in doc.get("resources", {}).items():
            owners = frozenset(spec.get("owners", []))
            if not owners:
                raise PolicyError(f"resource {name} has no owners")
            resources[name] = Resource(name, owners, tuple(spec.get("roles", [])),
                                       int(spec.get("max_days", 30)))
        delegation_path = policy_dir / "delegations.json"
        delegations = []
        if delegation_path.exists():
            entries = json.loads(delegation_path.read_text(encoding="utf-8"))["delegations"]
            for i, entry in enumerate(entries):
                try:
                    owner, delegate = entry["owner"], entry["delegate"]
                    scope = entry["resources"]
                    start = datetime.fromisoformat(entry["from"].replace("Z", "+00:00"))
                    end = datetime.fromisoformat(entry["until"].replace("Z", "+00:00"))
                    if (not isinstance(owner, str) or not owner
                            or not isinstance(delegate, str) or not delegate
                            or not isinstance(scope, list)
                            or not all(isinstance(r, str) and r for r in scope)
                            or start.utcoffset() is None or end.utcoffset() is None
                            or start >= end):
                        raise ValueError("invalid identity, scope, or window")
                except (KeyError, TypeError, AttributeError, ValueError) as exc:
                    raise PolicyError(f"invalid delegation at index {i}: {exc}") from exc
                delegations.append(Delegation(owner, delegate, frozenset(scope), start, end))
        return cls(resources, tuple(delegations))

    def resource(self, name: str) -> Resource:
        try:
            return self.resources[name]
        except KeyError:
            raise PolicyError(f"unknown resource {name!r}") from None

    def may_approve(self, approver: str, resource: str, at: datetime) -> bool:
        """True if `approver` may approve access to `resource` at time `at`."""
        res = self.resource(resource)
        return (approver in res.owners
                or self._delegating_owner(approver, res, at) is not None)

    def _delegating_owner(self, approver: str, resource: Resource,
                          at: datetime) -> str | None:
        # Deliberately check current ownership, never another delegation.
        for delegation in self.delegations:
            if (delegation.delegate == approver
                    and resource.name in delegation.resources
                    and delegation.owner in resource.owners
                    and delegation.starts_at <= at < delegation.ends_at):
                return delegation.owner
        return None

    def decide(self, req) -> Decision:
        try:
            res = self.resource(req.resource)
        except PolicyError as exc:
            return Decision(False, str(exc))
        if req.role not in res.roles:
            return Decision(False, f"role {req.role!r} does not exist on {res.name}")
        if req.duration_days > res.max_days:
            return Decision(False, f"{req.duration_days}d exceeds the {res.max_days}d limit for {res.name}")
        if not req.approvals:
            return Decision(False, "no approval on the ticket")
        rejected = []
        for appr in req.approvals:
            if appr.author == req.requester:
                rejected.append(f"{appr.author} (self-approval)")
            elif appr.at < req.submitted_at:
                rejected.append(f"{appr.author} (approval predates request)")
            elif appr.author in res.owners:
                return Decision(True, "approved", approved_by=appr.author)
            elif owner := self._delegating_owner(appr.author, res, appr.at):
                return Decision(True, "approved", approved_by=appr.author,
                                on_behalf_of=owner)
            else:
                rejected.append(f"{appr.author} (not an approver for {res.name})")
        return Decision(False, "no valid approval: " + "; ".join(rejected))
    request_id: str
    status: str  # granted | rejected | error
    reason: str


def _finish(path: Path, queue: Path, status: str, reason: str, approved_by=None,
            on_behalf_of=None) -> None:
    doc = json.loads(path.read_text(encoding="utf-8"))
    doc["bot"] = {"status": status, "reason": reason, "approved_by": approved_by}
    if on_behalf_of is not None:
        doc["bot"]["on_behalf_of"] = on_behalf_of
    dest = queue / ("done" if status == "granted" else "rejected") / path.name
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text(json.dumps(doc, indent=2) + "\n", encoding="utf-8")
    path.unlink()


def process_queue(root: Path, *, dry_run: bool = False) -> list[Outcome]:
    root = Path(root)
    queue = root / "queue"
    policy = Policy.load(root / "policy")
    store = GrantStore(root / "state")
    outcomes = []
    for path in sorted((queue / "pending").glob("*.json")):
        try:
            req = load_request(path)
        except TicketError as exc:
            outcomes.append(Outcome(path.stem, "error", str(exc)))
            continue
        decision = policy.decide(req)
        if dry_run:
            outcomes.append(Outcome(req.id, "granted" if decision.approved else "rejected",
                                    decision.reason))
            continue
        if decision.approved:
            store.grant(user=req.requester, resource=req.resource, role=req.role,
                        days=req.duration_days, request_id=req.id,
                        approved_by=decision.approved_by,
                        on_behalf_of=decision.on_behalf_of)
            _finish(path, queue, "granted", decision.reason, decision.approved_by,
                    decision.on_behalf_of)
            approval = f"approved by {decision.approved_by}"
            if decision.on_behalf_of is not None:
                approval += f" on behalf of {decision.on_behalf_of}"
            notify("#access-requests",
                   f"{req.id}: granted {req.role} on {req.resource} to {req.requester} "
                   f"for {req.duration_days}d ({approval})")
            outcomes.append(Outcome(req.id, "granted", decision.reason))
        else:
            _finish(path, queue, "rejected", decision.reason)
            notify("#access-requests", f"{req.id}: rejected -- {decision.reason}")
            outcomes.append(Outcome(req.id, "rejected", decision.reason))
    return outcomes


def archive(root: Path, request_id: str) -> Path:
    """Move a processed ticket out of done/ or rejected/ into archive/."""
    root = Path(root)
    for sub in ("done", "rejected"):
        p = root / "queue" / sub / f"{request_id}.json"
        if p.exists():
            dest = root / "queue" / "archive" / p.name
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(p, dest)
            return dest
    raise FileNotFoundError(request_id)
                return g
        return None

    def grant(self, *, user, resource, role, days, request_id, approved_by,
              on_behalf_of=None) -> dict:
        grants = self.load()
        entry = {
            "user": user,
            "resource": resource,
            "role": role,
            "granted": _iso(_now()),
            "expires": _iso(_now() + timedelta(days=days)),
            "request": request_id,
            "approved_by": approved_by,
        }
        if on_behalf_of is not None:
            entry["on_behalf_of"] = on_behalf_of
        grants = [g for g in grants
                  if (g["user"], g["resource"], g["role"]) != (user, resource, role)]
        grants.append(entry)
        self._save(grants)
        self._log("grant", **entry)
        return entry

    def revoke(self, user, resource, role, reason) -> bool:
        grants = self.load()
        kept = [g for g in grants if (g["user"], g["resource"], g["role"]) != (user, resource, role)]
        if len(kept) == len(grants):
            return False
        self._save(kept)
        self._log("revoke", user=user, resource=resource, role=role, reason=reason)
            if g.get("on_behalf_of"):
                approval += f" on behalf of {g['on_behalf_of']}"
            print(f"{g['user']:<12} {g['resource']:<22} {g['role']:<8} until {g['expires']}"
                  f"  ({g['request']}, {approval})")
        return 0
    if args.cmd == "revoke":
        ok = store.revoke(args.user, args.resource, args.role, args.reason)
        print("revoked" if ok else "no such grant")
        return 0 if ok else 1
    if args.cmd == "grant":
        entry = store.grant(user=args.user, resource=args.resource, role=args.role,
                            days=args.days, request_id=f"manual: {args.reason}",
                            approved_by="manual")
        notify("#access-audit", f"MANUAL grant {args.role} on {args.resource} to {args.user}"
                                f" until {entry['expires']}: {args.reason}")
        print(f"granted until {entry['expires']}")
        return 0
    return 2


