def test_delegated_approval_and_authority_query(root):
    make_delegation(root)
    d = decide(root)
    assert d.approved and d.approved_by == "deputy" and d.on_behalf_of == "alice"
    policy = Policy.load(root / "policy")
    assert policy.may_approve("deputy", "wiki", parse_ts(T))
    assert not policy.may_approve("deputy", "db", parse_ts(T))
    assert not policy.may_approve("deputy", "wiki", parse_ts("2026-11-21T00:00:00Z"))


@pytest.mark.parametrize("at,approved", [
    ("2026-11-19T23:59:59Z", False),
    ("2026-11-20T00:00:00Z", True),
    ("2026-11-20T23:59:59Z", True),
    ("2026-11-21T00:00:00Z", False),
    ("2026-11-21T00:00:01Z", False),
    ("2026-11-20T02:00:00+02:00", True),
    ("2026-11-21T02:00:00+02:00", False),
])
def test_approval_window_is_half_open(root, at, approved):
    make_delegation(root)
    d = decide(root, at=at, submitted="2026-11-19T00:00:00Z")
    assert d.approved is approved


def test_checks_approval_time_not_processing_time(root):
    make_delegation(root, start="2020-01-01T00:00:00Z", end="2020-01-02T00:00:00Z")
    assert decide(root, at="2020-01-01T12:00:00Z",
                  submitted="2020-01-01T11:00:00Z").approved


@pytest.mark.parametrize("entry", [
    {"owner": "bob"},  # owner of a different resource
    {"owner": "former-owner"},
    {"resources": ["db"]},
    {"delegate": "someone-else"},
    {"resources": []},
])
def test_scope_identity_and_current_owner_required(root, entry):
    make_delegation(root, **entry)
    assert not decide(root).approved


def test_former_owner_entry_loses_authority(root):
    make_delegation(root)
    path = root / "policy/owners.json"
    doc = json.loads(path.read_text())
    doc["resources"]["wiki"]["owners"] = ["new-owner"]
    path.write_text(json.dumps(doc))
    assert not decide(root).approved


def test_delegations_never_chain(root):
    make_delegation(root)
    make_delegation(root, owner="deputy", delegate="second-deputy")
    assert decide(root).approved
    assert not decide(root, approver="second-deputy").approved


def test_cycles_do_not_confer_authority(root):
    make_delegation(root, owner="second-deputy")
    make_delegation(root, owner="deputy", delegate="second-deputy")
    assert not decide(root).approved


def test_scope_can_include_multiple_owned_resources(root):
    make_delegation(root, owner="bob", resources=["wiki", "db"])
    assert decide(root, resource="db", role="admin").approved
    assert not decide(root).approved  # bob does not own wiki


def test_skip_non_matching_delegations(root):
    make_delegation(root, owner="former-owner")
    make_delegation(root, start="2026-11-01T00:00:00Z", end="2026-11-02T00:00:00Z")
    make_delegation(root)
    assert decide(root).on_behalf_of == "alice"


