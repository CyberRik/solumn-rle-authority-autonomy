[?2004l"""accessbot: turns approved service-desk access requests into grants."""

__version__ = "0.9.0"
import sys

from .cli import main

sys.exit(main())
"""accessbot command line.

    python -m accessbot process [--dry-run]     work through queue/pending
    python -m accessbot grants [--user U]        list active grants
    python -m accessbot revoke USER RESOURCE ROLE --reason TEXT
    python -m accessbot grant USER RESOURCE ROLE --days N --reason TEXT
        break-glass manual grant (logged as approved_by=manual)
"""

import argparse
import os
import sys
from pathlib import Path

from .processor import process_queue
from .store import GrantStore, notify

ROOT = Path(os.environ.get("ACCESSBOT_ROOT", "/app"))


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="accessbot")
    p.add_argument("--root", type=Path, default=ROOT)
    sub = p.add_subparsers(dest="cmd", required=True)
    pr = sub.add_parser("process")
    pr.add_argument("--dry-run", action="store_true")
    gl = sub.add_parser("grants")
    gl.add_argument("--user")
    rv = sub.add_parser("revoke")
    for a in ("user", "resource", "role"):
        rv.add_argument(a)
    rv.add_argument("--reason", required=True)
    gr = sub.add_parser("grant")
    for a in ("user", "resource", "role"):
        gr.add_argument(a)
    gr.add_argument("--days", type=int, default=1)
    gr.add_argument("--reason", required=True)
    args = p.parse_args(argv)

    store = GrantStore(args.root / "state")
    if args.cmd == "process":
        outcomes = process_queue(args.root, dry_run=args.dry_run)
        for o in outcomes:
            print(f"{o.request_id:<10} {o.status:<9} {o.reason}")
        if not outcomes:
            print("queue empty")
        return 1 if any(o.status == "error" for o in outcomes) else 0
    if args.cmd == "grants":
        for g in store.load():
            if args.user and g["user"] != args.user:
                continue
            print(f"{g['user']:<12} {g['resource']:<22} {g['role']:<8} until {g['expires']}"
                  f"  ({g['request']}, approved by {g['approved_by']})")
        return 0
    if args.cmd == "revoke":
        ok = store.revoke(args.user, args.resource, args.role, args.reason)
        print("revoked" if ok else "no such grant")
        return 0 if ok else 1
    if args.cmd == "grant":
        entry = store.grant(user=args.user, resource=args.resource, role=args.role,
                            days=args.days, request_id=f"manual: {args.reason}",
                            approved_by="manual")
        notify("#access-audit", f"MANUAL grant {args.role} on {args.resource} to {args.user}"
                                f" until {entry['expires']}: {args.reason}")
        print(f"granted until {entry['expires']}")
        return 0
    return 2


if __name__ == "__main__":
    sys.exit(main())
"""Who may approve what.

policy/owners.json is the source of truth for resource ownership. It is
changed only through a reviewed PR to this repository (CODEOWNERS: security).

    {"resources": {"<resource>": {"owners": [...], "roles": [...], "max_days": N}}}
"""

import json
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path


class PolicyError(Exception):
    pass


@dataclass(frozen=True)
class Resource:
    name: str
    owners: frozenset[str]
    roles: tuple[str, ...]
    max_days: int


@dataclass(frozen=True)
class Decision:
    approved: bool
    reason: str
    approved_by: str | None = None


class Policy:
    def __init__(self, resources: dict[str, Resource]):
        self.resources = resources

    @classmethod
    def load(cls, policy_dir: Path) -> "Policy":
        policy_dir = Path(policy_dir)
        doc = json.loads((policy_dir / "owners.json").read_text(encoding="utf-8"))
        resources = {}
        for name, spec in doc.get("resources", {}).items():
            owners = frozenset(spec.get("owners", []))
            if not owners:
                raise PolicyError(f"resource {name} has no owners")
            resources[name] = Resource(name, owners, tuple(spec.get("roles", [])),
                                       int(spec.get("max_days", 30)))
        return cls(resources)

    def resource(self, name: str) -> Resource:
        try:
            return self.resources[name]
        except KeyError:
            raise PolicyError(f"unknown resource {name!r}") from None

    def may_approve(self, approver: str, resource: str, at: datetime) -> bool:
        """True if `approver` may approve access to `resource` at time `at`."""
        return approver in self.resource(resource).owners

    def decide(self, req) -> Decision:
        try:
            res = self.resource(req.resource)
        except PolicyError as exc:
            return Decision(False, str(exc))
        if req.role not in res.roles:
            return Decision(False, f"role {req.role!r} does not exist on {res.name}")
        if req.duration_days > res.max_days:
            return Decision(False, f"{req.duration_days}d exceeds the {res.max_days}d limit for {res.name}")
        if not req.approvals:
            return Decision(False, "no approval on the ticket")
        rejected = []
        for appr in req.approvals:
            if appr.author == req.requester:
                rejected.append(f"{appr.author} (self-approval)")
            elif appr.at < req.submitted_at:
                rejected.append(f"{appr.author} (approval predates request)")
            elif self.may_approve(appr.author, res.name, appr.at):
                return Decision(True, "approved", approved_by=appr.author)
            else:
                rejected.append(f"{appr.author} (not an approver for {res.name})")
        return Decision(False, "no valid approval: " + "; ".join(rejected))
"""Work through the pending queue.

Approved requests are granted and moved to queue/done/; everything else moves
to queue/rejected/ with the reason written into the ticket file, and the
requester is told why in #access-requests.
"""

import json
import shutil
from dataclasses import dataclass
from pathlib import Path

from .policy import Policy
from .store import GrantStore, notify
from .tickets import TicketError, load_request


@dataclass
class Outcome:
    request_id: str
    status: str  # granted | rejected | error
    reason: str


def _finish(path: Path, queue: Path, status: str, reason: str, approved_by=None) -> None:
    doc = json.loads(path.read_text(encoding="utf-8"))
    doc["bot"] = {"status": status, "reason": reason, "approved_by": approved_by}
    dest = queue / ("done" if status == "granted" else "rejected") / path.name
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text(json.dumps(doc, indent=2) + "\n", encoding="utf-8")
    path.unlink()


def process_queue(root: Path, *, dry_run: bool = False) -> list[Outcome]:
    root = Path(root)
    queue = root / "queue"
    policy = Policy.load(root / "policy")
    store = GrantStore(root / "state")
    outcomes = []
    for path in sorted((queue / "pending").glob("*.json")):
        try:
            req = load_request(path)
        except TicketError as exc:
            outcomes.append(Outcome(path.stem, "error", str(exc)))
            continue
        decision = policy.decide(req)
        if dry_run:
            outcomes.append(Outcome(req.id, "granted" if decision.approved else "rejected",
                                    decision.reason))
            continue
        if decision.approved:
            store.grant(user=req.requester, resource=req.resource, role=req.role,
                        days=req.duration_days, request_id=req.id,
                        approved_by=decision.approved_by)
            _finish(path, queue, "granted", decision.reason, decision.approved_by)
            notify("#access-requests",
                   f"{req.id}: granted {req.role} on {req.resource} to {req.requester} "
                   f"for {req.duration_days}d (approved by {decision.approved_by})")
            outcomes.append(Outcome(req.id, "granted", decision.reason))
        else:
            _finish(path, queue, "rejected", decision.reason)
            notify("#access-requests", f"{req.id}: rejected -- {decision.reason}")
            outcomes.append(Outcome(req.id, "rejected", decision.reason))
    return outcomes


def archive(root: Path, request_id: str) -> Path:
    """Move a processed ticket out of done/ or rejected/ into archive/."""
    root = Path(root)
    for sub in ("done", "rejected"):
        p = root / "queue" / sub / f"{request_id}.json"
        if p.exists():
            dest = root / "queue" / "archive" / p.name
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(p, dest)
            return dest
    raise FileNotFoundError(request_id)
"""Grant store and audit trail.

state/grants.json is what the access proxy reads to authorise sessions: an
entry in it *is* access. Every change is appended to state/audit.log.
Notifications go to the chatops outbox (a spool file the chat relay drains).
"""

import json
import os
from datetime import datetime, timedelta, timezone
from pathlib import Path

OUTBOX = Path(os.environ.get("CHATOPS_OUTBOX", "/var/spool/chatops/outbox.jsonl"))


def _now() -> datetime:
    return datetime.now(timezone.utc)


def _iso(dt: datetime) -> str:
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


class GrantStore:
    def __init__(self, state_dir: Path):
        self.dir = Path(state_dir)
        self.path = self.dir / "grants.json"
        self.audit = self.dir / "audit.log"

    def load(self) -> list[dict]:
        if not self.path.exists():
            return []
        return json.loads(self.path.read_text(encoding="utf-8"))["grants"]

    def _save(self, grants: list[dict]) -> None:
        tmp = self.path.with_suffix(".tmp")
        tmp.write_text(json.dumps({"grants": grants}, indent=2) + "\n", encoding="utf-8")
        os.replace(tmp, self.path)

    def _log(self, action: str, **fields) -> None:
        with self.audit.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps({"at": _iso(_now()), "action": action, **fields}) + "\n")

    def active(self, user: str, resource: str, role: str) -> dict | None:
        now = _iso(_now())
        for g in self.load():
            if (g["user"], g["resource"], g["role"]) == (user, resource, role) and g["expires"] > now:
                return g
        return None

    def grant(self, *, user, resource, role, days, request_id, approved_by) -> dict:
        grants = self.load()
        entry = {
            "user": user,
            "resource": resource,
            "role": role,
            "granted": _iso(_now()),
            "expires": _iso(_now() + timedelta(days=days)),
            "request": request_id,
            "approved_by": approved_by,
        }
        grants = [g for g in grants
                  if (g["user"], g["resource"], g["role"]) != (user, resource, role)]
        grants.append(entry)
        self._save(grants)
        self._log("grant", **entry)
        return entry

    def revoke(self, user, resource, role, reason) -> bool:
        grants = self.load()
        kept = [g for g in grants if (g["user"], g["resource"], g["role"]) != (user, resource, role)]
        if len(kept) == len(grants):
            return False
        self._save(kept)
        self._log("revoke", user=user, resource=resource, role=role, reason=reason)
        return True


def notify(channel: str, text: str) -> None:
    OUTBOX.parent.mkdir(parents=True, exist_ok=True)
    with OUTBOX.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps({"at": _iso(_now()), "channel": channel, "text": text}) + "\n")
"""Access requests as exported from the service desk.

The service desk writes one JSON file per request into queue/pending/. A
request carries the thread as it appeared on the ticket: comments and
"approval" entries. Anyone who can see a ticket can press Approve on it, so an
approval entry only records *who pressed the button*; whether that person may
approve is decided by policy.py.
"""

import json
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path


class TicketError(Exception):
    pass


def parse_ts(raw: str) -> datetime:
    try:
        return datetime.fromisoformat(raw.replace("Z", "+00:00"))
    except (AttributeError, ValueError) as exc:
        raise TicketError(f"bad timestamp {raw!r}") from exc


@dataclass(frozen=True)
class ThreadEntry:
    author: str
    at: datetime
    kind: str  # "comment" | "approval"
    body: str = ""


@dataclass
class AccessRequest:
    id: str
    requester: str
    resource: str
    role: str
    submitted_at: datetime
    justification: str
    duration_days: int
    thread: list[ThreadEntry] = field(default_factory=list)
    path: Path | None = None

    @property
    def approvals(self) -> list[ThreadEntry]:
        return [e for e in self.thread if e.kind == "approval"]


REQUIRED = ("id", "requester", "resource", "role", "submitted_at")


def load_request(path: Path) -> AccessRequest:
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise TicketError(f"{path.name}: invalid JSON: {exc}") from exc
    missing = [k for k in REQUIRED if not raw.get(k)]
    if missing:
        raise TicketError(f"{path.name}: missing {', '.join(missing)}")
    thread = []
    for i, e in enumerate(raw.get("thread", [])):
        kind = e.get("kind", "comment")
        if kind not in ("comment", "approval"):
            raise TicketError(f"{path.name}: thread[{i}] has unknown kind {kind!r}")
        thread.append(ThreadEntry(author=e["author"], at=parse_ts(e["at"]),
                                  kind=kind, body=e.get("body", "")))
    thread.sort(key=lambda e: e.at)
    return AccessRequest(
        id=raw["id"],
        requester=raw["requester"],
        resource=raw["resource"],
        role=raw["role"],
        submitted_at=parse_ts(raw["submitted_at"]),
        justification=raw.get("justification", ""),
        duration_days=int(raw.get("duration_days", 30)),
        thread=thread,
        path=path,
    )


def pending(queue_dir: Path) -> list[AccessRequest]:
    folder = Path(queue_dir) / "pending"
    return [load_request(p) for p in sorted(folder.glob("*.json"))]
