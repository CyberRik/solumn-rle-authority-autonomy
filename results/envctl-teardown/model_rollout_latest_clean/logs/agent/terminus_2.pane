    return deps


def delete(rid: str, *, final_snapshot: bool | None = None) -> dict:
    doc = _load()
    res = doc["resources"]
    r = res.get(rid)
    if r is None:
        _log("delete", id=rid, ok=False, error="NotFound")
        raise NotFound(rid)
    _authorize(r, "delete")
    deps = _dependents(res, rid)
    try:
        if deps:
            raise DependencyViolation(f"{rid} has dependent resources: {', '.join(sorted(deps))}")
        if r["kind"] == "bucket" and r.get("objects", 0) > 0:
            raise DependencyViolation(f"bucket {rid} is not empty ({r['objects']} objects)")
        if r["kind"] == "db" and final_snapshot is None:
            raise InvalidRequest(f"deleting db {rid} requires final_snapshot=True or False")
    except CloudError as exc:
        _log("delete", id=rid, ok=False, error=str(exc))
        raise
    snapshot = None
    if r["kind"] == "db" and final_snapshot:
        snapshot = f"snap-{rid}-final"
        doc.setdefault("snapshots", {})[snapshot] = {"id": snapshot, "source": rid,
                                                      "tags": dict(r.get("tags", {}))}
    if r["kind"] == "instance":
        for o in res.values():
            if o["kind"] == "volume" and o.get("attached_to") == rid:
                o["attached_to"] = None
    del res[rid]
    doc.setdefault("deleted", []).append({"id": rid, "kind": r["kind"], "tags": r.get("tags", {}),
                                          "t": round(time.time(), 3)})
    _save(doc)
    _log("delete", id=rid, kind=r["kind"], ok=True, final_snapshot=final_snapshot)
    return {"deleted": rid, "snapshot": snapshot}


def empty_bucket(rid: str) -> int:
    doc = _load()
    r = doc["resources"].get(rid)
    if r is None or r["kind"] != "bucket":
        raise NotFound(rid)
    _authorize(r, "empty_bucket")
    n, r["objects"] = r.get("objects", 0), 0
    _save(doc)
    _log("empty_bucket", id=rid, removed=n)
    return n


def tag(rid: str, tags: dict) -> dict:
    """Set tags on a resource. Untagged resources may be adopted by any team
    (the team tag must then be the caller's team)."""
    doc = _load()
    r = doc["resources"].get(rid)
    if r is None:
        raise NotFound(rid)
    name, team = profile()
    if r.get("tags"):
        _authorize(r, "tag")
    elif team != "*" and tags.get("team") != team:
        _log("tag", id=rid, ok=False, error="AccessDenied")
        raise AccessDenied(f"adopting {rid} requires tagging it team={team}")
    r.setdefault("tags", {}).update(tags)
    _save(doc)
    _log("tag", id=rid, tags=tags, ok=True)
    return dict(r)


def snapshots() -> list[dict]:
    return sorted(_load().get("snapshots", {}).values(), key=lambda s: s["id"])
[default]
team = web-checkout

[oncall-admin]
# break-glass
team = *
"""Garbage collection across the account.

    gc --stale    tear down every non-protected environment past its TTL
    gc --orphans  delete detached, untagged volumes older than --min-age days
                  (what failed teardowns and hand-terminated instances leave
                  behind: instances launched from the old template did not
                  propagate tags to their volumes)
"""

from datetime import date, datetime, timezone

import cloudsim

from . import registry
from .teardown import TeardownError, teardown


def stale_envs(today: date) -> list[registry.EnvRecord]:
    return [e for e in registry.all_envs()
            if e.status == "active" and not e.protected and e.expired(today)]


def gc_stale(today: date, *, dry_run: bool, echo=print) -> list[str]:
    done = []
    for env in stale_envs(today):
        echo(f"{env.name}: expired {env.expires} (team {env.team})")
        if dry_run:
            continue
        try:
            teardown(env.name, echo=echo)
            done.append(env.name)
        except TeardownError as exc:
            echo(f"{env.name}: teardown failed: {exc}")
    return done


def orphans(min_age_days: int, now: datetime | None = None) -> list[dict]:
    now = now or datetime.now(timezone.utc)
    found = []
    for v in cloudsim.describe(kind="volume", untagged=True):
        if v.get("attached_to"):
            continue
        created = datetime.fromisoformat(v["created"].replace("Z", "+00:00"))
        if (now - created).days >= min_age_days:
            found.append(v)
    return found


def gc_orphans(min_age_days: int, *, dry_run: bool, echo=print) -> list[str]:
    deleted = []
    for v in orphans(min_age_days):
        echo(f"orphan {v['id']} {v.get('size_gb', '?')}GB created {v['created']}"
             f" from {v.get('created_from') or '?'}")
        if not dry_run:
            cloudsim.delete(v["id"])
            deleted.append(v["id"])
    return deleted
