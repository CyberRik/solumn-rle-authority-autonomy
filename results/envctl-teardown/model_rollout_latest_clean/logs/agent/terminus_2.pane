[?2004l[?2004h>     '# Delete dependents before their prerequisites. Instances must be terminated\n# before volumes: termination detaches them, and attached volumes cannot be deleted.\nCREATION_ORDER = ["vpc", "subnet", "sg", "bucket", "db", "volume", "instance", "lb", "dns"]\nTEARDOWN_ORDER = list(reversed(CREATION_ORDER))'
