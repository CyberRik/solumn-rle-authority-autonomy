--- Retry ---
"""Deterministic exponential backoff for webhook deliveries."""

from hashlib import sha256


def backoff_delay(event_id: str, attempt: int, retry_after: int | None = None) -> float:
    """Return seconds to wait after an attempt, capped at one hour.

    ``attempt`` counts attempts already made (1 after the first failure).
    Event-specific jitter spreads retries while remaining reproducible.
    """
    base = min(30 * 2 ** (attempt - 1), 3600)
    h = int(sha256(f"{event_id}:{attempt}".encode()).hexdigest()[:8], 16)
    factor = 0.9 + 0.2 * h / 0xFFFFFFFF
    delay = base * factor
    if retry_after is not None:
        delay = max(delay, retry_after)
    return min(delay, 3600)

--- Dispatcher ---
"""Dispatch due deliveries, retrying transient failures and dead-lettering others."""

import logging
from dataclasses import dataclass

from . import transport
from .outbox import Outbox
from .retry import backoff_delay

log = logging.getLogger("hookrelay.dispatch")


@dataclass
class DispatchStats:
    delivered: int = 0
    retried: int = 0
    dead: int = 0

    def as_dict(self):
        return {"delivered": self.delivered, "retried": self.retried, "dead": self.dead}


class Dispatcher:
    def __init__(self, outbox: Outbox, secret: str, *, send=transport.post,
                 timeout: float = 10.0, max_attempts: int = 8):
        self.outbox = outbox
        self.secret = secret
        self.send = send
        self.timeout = timeout
        self.max_attempts = max_attempts

    def run_once(self, limit: int = 100) -> DispatchStats:
        stats = DispatchStats()
        for row in self.outbox.due(limit):
            result = self.send(row["endpoint"], row["body"], self.secret,
                               event_id=row["event_id"], timeout=self.timeout)
            attempts = row["attempts"] + 1
            if result.outcome == "delivered":
                self.outbox.update(row["id"], status="delivered", attempts=attempts, last_error="")
                stats.delivered += 1
            elif result.outcome == "retryable" and attempts < self.max_attempts:
                delay = backoff_delay(row["event_id"], attempts, result.retry_after)
                self.outbox.update(row["id"], status="pending", attempts=attempts,
                                   next_attempt_at=self.outbox.clock() + delay,
                                   last_error=result.error)
                stats.retried += 1
            else:
                prefix = "permanent" if result.outcome == "permanent" else "max attempts"
                reason = f"{prefix}: {result.error}"
                self.outbox.dead_letter(row["id"], attempts=attempts,
                                        last_error=result.error, reason=reason)
                stats.dead += 1
                log.warning("delivery %s to %s dead-lettered: %s",
                            row["id"], row["endpoint"], reason)
        return stats

--- Outbox ---
"""Persistent outbox of webhook deliveries (SQLite).

    deliveries(id, event_id, endpoint, body, status, attempts, next_attempt_at,
               last_error, created_at, updated_at)

status: pending | delivered | dead
"""

import sqlite3
import time
import uuid

SCHEMA = """
CREATE TABLE IF NOT EXISTS deliveries (
    id              TEXT PRIMARY KEY,
    event_id        TEXT NOT NULL,
    endpoint        TEXT NOT NULL,
    body            BLOB NOT NULL,
    status          TEXT NOT NULL DEFAULT 'pending',
    attempts        INTEGER NOT NULL DEFAULT 0,
    next_attempt_at REAL NOT NULL,
    last_error      TEXT NOT NULL DEFAULT '',
    created_at      REAL NOT NULL,
    updated_at      REAL NOT NULL,
    UNIQUE (event_id, endpoint)
);
CREATE TABLE IF NOT EXISTS dead_letters (
    delivery_id TEXT NOT NULL,
    event_id    TEXT NOT NULL,
    endpoint    TEXT NOT NULL,
    attempts    INTEGER NOT NULL,
    reason      TEXT NOT NULL,
    at          REAL NOT NULL
);
"""


class Outbox:
    def __init__(self, path: str, clock=time.time):
        self.conn = sqlite3.connect(path, isolation_level=None)
        self.conn.row_factory = sqlite3.Row
        self.conn.executescript(SCHEMA)
        self.clock = clock

    def enqueue(self, event_id: str, endpoint: str, body: bytes) -> str | None:
        """Queue a delivery; returns its id, or None if this event was already
        queued for this endpoint (idempotent)."""
        now = self.clock()
        did = uuid.uuid4().hex
        cur = self.conn.execute(
            "INSERT OR IGNORE INTO deliveries (id, event_id, endpoint, body, next_attempt_at,"
            " created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?)",
            (did, event_id, endpoint, body, now, now, now))
        return did if cur.rowcount else None

    def due(self, limit: int = 100) -> list[sqlite3.Row]:
        return self.conn.execute(
            "SELECT * FROM deliveries WHERE status = 'pending' AND next_attempt_at <= ?"
            " ORDER BY next_attempt_at, created_at LIMIT ?", (self.clock(), limit)).fetchall()

    def get(self, did: str) -> sqlite3.Row | None:
        return self.conn.execute("SELECT * FROM deliveries WHERE id = ?", (did,)).fetchone()

    def update(self, did: str, **fields) -> None:
        fields["updated_at"] = self.clock()
        cols = ", ".join(f"{k} = ?" for k in fields)
        self.conn.execute(f"UPDATE deliveries SET {cols} WHERE id = ?", (*fields.values(), did))

    def counts(self) -> dict:
        rows = self.conn.execute("SELECT status, count(*) n FROM deliveries GROUP BY status")
        return {r["status"]: r["n"] for r in rows}

    def dead_letter(self, did: str, *, attempts: int, last_error: str, reason: str) -> None:
        """Atomically mark a delivery dead and append its dead-letter record."""
        now = self.clock()
        with self.conn:
            # The connection is normally in autocommit mode. Start a transaction
            # explicitly so the status and audit record cannot get out of sync.
            self.conn.execute("BEGIN IMMEDIATE")
            self.conn.execute(
                "UPDATE deliveries SET status = 'dead', attempts = ?, last_error = ?,"
                " updated_at = ? WHERE id = ?", (attempts, last_error, now, did))
            self.conn.execute(
                "INSERT INTO dead_letters (delivery_id, event_id, endpoint, attempts, reason, at)"
                " SELECT id, event_id, endpoint, attempts, ?, ? FROM deliveries WHERE id = ?",
                (reason, now, did))

    def dead_letters(self) -> list[sqlite3.Row]:
        """Return dead-letter history, oldest first (including replayed deliveries)."""
        return self.conn.execute("SELECT * FROM dead_letters ORDER BY at, rowid").fetchall()

    def replay(self, delivery_id: str) -> bool:
        """Reset a dead delivery for immediate dispatch; keep its audit history."""
        now = self.clock()
        cur = self.conn.execute(
            "UPDATE deliveries SET status = 'pending', attempts = 0, next_attempt_at = ?,"
            " last_error = '', updated_at = ? WHERE id = ? AND status = 'dead'",
            (now, now, delivery_id))
        return bool(cur.rowcount)

--- CLI ---
"""hookrelay command line.

    python -m hookrelay enqueue EVENT_ID ENDPOINT BODY_FILE
    python -m hookrelay dispatch [--limit N]
    python -m hookrelay status
    python -m hookrelay dlq
    python -m hookrelay replay ID
"""

import argparse
import json
import sys
from pathlib import Path

from . import config
from .dispatcher import Dispatcher
from .outbox import Outbox

SETTINGS = config.load()
DB = SETTINGS.db
SECRET_FILE = str(SETTINGS.secret_file)


def _secret() -> str:
    return Path(SECRET_FILE).read_text().strip()


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="hookrelay")
    sub = p.add_subparsers(dest="cmd", required=True)
    e = sub.add_parser("enqueue")
    e.add_argument("event_id")
    e.add_argument("endpoint")
    e.add_argument("body_file", type=Path)
    d = sub.add_parser("dispatch")
    d.add_argument("--limit", type=int, default=SETTINGS.batch)
    sub.add_parser("status")
    sub.add_parser("dlq")
    r = sub.add_parser("replay")
    r.add_argument("delivery_id")
    args = p.parse_args(argv)

    Path(DB).parent.mkdir(parents=True, exist_ok=True)
    outbox = Outbox(DB)
    if args.cmd == "enqueue":
        did = outbox.enqueue(args.event_id, args.endpoint, args.body_file.read_bytes())
        print(did or "duplicate: already queued")
    elif args.cmd == "dispatch":
        stats = Dispatcher(outbox, _secret(), timeout=SETTINGS.timeout).run_once(args.limit)
        print(json.dumps(stats.as_dict()))
    elif args.cmd == "dlq":
        print(json.dumps([dict(row) for row in outbox.dead_letters()]))
    elif args.cmd == "replay":
        replayed = outbox.replay(args.delivery_id)
        print(json.dumps({"replayed": replayed}))
        return 0 if replayed else 1
    else:
        print(json.dumps(outbox.counts()))
    return 0


if __name__ == "__main__":
    sys.exit(main())

