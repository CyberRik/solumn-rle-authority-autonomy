"""hookrelay: signed webhook delivery with a persistent outbox."""

__version__ = "1.4.0"

--- hookrelay/__main__.py ---
import sys

from .cli import main

sys.exit(main())

--- hookrelay/cli.py ---
"""hookrelay command line.

    python -m hookrelay enqueue EVENT_ID ENDPOINT BODY_FILE
    python -m hookrelay dispatch [--limit N]
    python -m hookrelay status
"""

import argparse
import json
import os
import sys
from pathlib import Path

from . import config
from .dispatcher import Dispatcher
from .outbox import Outbox

SETTINGS = config.load()
DB = SETTINGS.db
SECRET_FILE = str(SETTINGS.secret_file)


def _secret() -> str:
    return Path(SECRET_FILE).read_text().strip()


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="hookrelay")
    sub = p.add_subparsers(dest="cmd", required=True)
    e = sub.add_parser("enqueue")
    e.add_argument("event_id")
    e.add_argument("endpoint")
    e.add_argument("body_file", type=Path)
    d = sub.add_parser("dispatch")
    d.add_argument("--limit", type=int, default=SETTINGS.batch)
    sub.add_parser("status")
    args = p.parse_args(argv)

    Path(DB).parent.mkdir(parents=True, exist_ok=True)
    outbox = Outbox(DB)
    if args.cmd == "enqueue":
        did = outbox.enqueue(args.event_id, args.endpoint, args.body_file.read_bytes())
        print(did or "duplicate: already queued")
    elif args.cmd == "dispatch":
        stats = Dispatcher(outbox, _secret(), timeout=SETTINGS.timeout).run_once(args.limit)
        print(json.dumps(stats.as_dict()))
    else:
        print(json.dumps(outbox.counts()))
    return 0


if __name__ == "__main__":
    sys.exit(main())

--- hookrelay/config.py ---
"""Runtime settings, from the environment with defaults.

    HOOKRELAY_DB            outbox database        (/app/var/outbox.db)
    HOOKRELAY_SECRET_FILE   signing key file       (/app/var/signing.key)
    HOOKRELAY_TIMEOUT       per-attempt seconds    (10)
    HOOKRELAY_BATCH         deliveries per run     (100)
"""

import os
from dataclasses import dataclass
from pathlib import Path


class ConfigError(Exception):
    pass


@dataclass(frozen=True)
class Settings:
    db: str
    secret_file: Path
    timeout: float
    batch: int

    def secret(self) -> str:
        try:
            key = self.secret_file.read_text().strip()
        except OSError as exc:
            raise ConfigError(f"cannot read signing key {self.secret_file}: {exc}") from exc
        if not key:
            raise ConfigError(f"signing key {self.secret_file} is empty")
        return key


def _number(env, name, default, kind):
    raw = env.get(name)
    if raw is None or raw == "":
        return default
    try:
        value = kind(raw)
    except ValueError:
        raise ConfigError(f"{name}={raw!r} is not a valid {kind.__name__}") from None
    if value <= 0:
        raise ConfigError(f"{name} must be positive")
    return value


def load(env=None) -> Settings:
    env = os.environ if env is None else env
    return Settings(
        db=env.get("HOOKRELAY_DB", "/app/var/outbox.db"),
        secret_file=Path(env.get("HOOKRELAY_SECRET_FILE", "/app/var/signing.key")),
        timeout=_number(env, "HOOKRELAY_TIMEOUT", 10.0, float),
        batch=_number(env, "HOOKRELAY_BATCH", 100, int),
    )

--- hookrelay/dispatcher.py ---
"""Dispatch due deliveries from the outbox.

Today a delivery gets exactly one attempt: anything other than a 2xx marks it
failed. See docs/RETRIES.md for the retry / dead-letter design (HR-212).
"""

import logging
from dataclasses import dataclass

from . import transport
from .outbox import Outbox

log = logging.getLogger("hookrelay.dispatch")


@dataclass
class DispatchStats:
    delivered: int = 0
    failed: int = 0

    def as_dict(self):
        return {"delivered": self.delivered, "failed": self.failed}


class Dispatcher:
    def __init__(self, outbox: Outbox, secret: str, *, send=transport.post, timeout: float = 10.0):
        self.outbox = outbox
        self.secret = secret
        self.send = send
        self.timeout = timeout

    def run_once(self, limit: int = 100) -> DispatchStats:
        stats = DispatchStats()
        for row in self.outbox.due(limit):
            result = self.send(row["endpoint"], row["body"], self.secret,
                               event_id=row["event_id"], timeout=self.timeout)
            attempts = row["attempts"] + 1
            if result.outcome == "delivered":
                self.outbox.update(row["id"], status="delivered", attempts=attempts, last_error="")
                stats.delivered += 1
            else:
                self.outbox.update(row["id"], status="failed", attempts=attempts,
                                   last_error=result.error)
                stats.failed += 1
                log.warning("delivery %s to %s failed: %s", row["id"], row["endpoint"], result.error)
        return stats

--- hookrelay/outbox.py ---
"""Persistent outbox of webhook deliveries (SQLite).

    deliveries(id, event_id, endpoint, body, status, attempts, next_attempt_at,
               last_error, created_at, updated_at)

status: pending | delivered | failed
"""

import sqlite3
import time
import uuid

SCHEMA = """
CREATE TABLE IF NOT EXISTS deliveries (
    id              TEXT PRIMARY KEY,
    event_id        TEXT NOT NULL,
    endpoint        TEXT NOT NULL,
    body            BLOB NOT NULL,
    status          TEXT NOT NULL DEFAULT 'pending',
    attempts        INTEGER NOT NULL DEFAULT 0,
    next_attempt_at REAL NOT NULL,
    last_error      TEXT NOT NULL DEFAULT '',
    created_at      REAL NOT NULL,
    updated_at      REAL NOT NULL,
    UNIQUE (event_id, endpoint)
);
"""


class Outbox:
    def __init__(self, path: str, clock=time.time):
        self.conn = sqlite3.connect(path, isolation_level=None)
        self.conn.row_factory = sqlite3.Row
        self.conn.executescript(SCHEMA)
        self.clock = clock

    def enqueue(self, event_id: str, endpoint: str, body: bytes) -> str | None:
        """Queue a delivery; returns its id, or None if this event was already
        queued for this endpoint (idempotent)."""
        now = self.clock()
        did = uuid.uuid4().hex
        cur = self.conn.execute(
            "INSERT OR IGNORE INTO deliveries (id, event_id, endpoint, body, next_attempt_at,"
            " created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?)",
            (did, event_id, endpoint, body, now, now, now))
        return did if cur.rowcount else None

    def due(self, limit: int = 100) -> list[sqlite3.Row]:
        return self.conn.execute(
            "SELECT * FROM deliveries WHERE status = 'pending' AND next_attempt_at <= ?"
            " ORDER BY next_attempt_at, created_at LIMIT ?", (self.clock(), limit)).fetchall()

    def get(self, did: str) -> sqlite3.Row | None:
        return self.conn.execute("SELECT * FROM deliveries WHERE id = ?", (did,)).fetchone()

    def update(self, did: str, **fields) -> None:
        fields["updated_at"] = self.clock()
        cols = ", ".join(f"{k} = ?" for k in fields)
        self.conn.execute(f"UPDATE deliveries SET {cols} WHERE id = ?", (*fields.values(), did))

    def counts(self) -> dict:
        rows = self.conn.execute("SELECT status, count(*) n FROM deliveries GROUP BY status")
        return {r["status"]: r["n"] for r in rows}

--- hookrelay/signing.py ---
"""Webhook signatures.

Header: X-Hookrelay-Signature: t=<unix seconds>,v1=<hex hmac-sha256>
The signed payload is f"{t}.{body}". Receivers reject signatures older than the
tolerance to stop replays.
"""

import hashlib
import hmac
import time


class SignatureError(Exception):
    pass


def sign(secret: str, body: bytes, timestamp: int | None = None) -> str:
    t = int(time.time()) if timestamp is None else int(timestamp)
    mac = hmac.new(secret.encode(), f"{t}.".encode() + body, hashlib.sha256).hexdigest()
    return f"t={t},v1={mac}"


def parse_header(header: str) -> tuple[int, list[str]]:
    t, sigs = None, []
    for part in header.split(","):
        key, _, value = part.strip().partition("=")
        if key == "t":
            try:
                t = int(value)
            except ValueError:
                raise SignatureError("bad timestamp") from None
        elif key == "v1" and value:
            sigs.append(value)
    if t is None or not sigs:
        raise SignatureError("malformed signature header")
    return t, sigs


def verify(secret: str, body: bytes, header: str, *, tolerance: int = 300, now: int | None = None) -> int:
    t, sigs = parse_header(header)
    now = int(time.time()) if now is None else now
    if abs(now - t) > tolerance:
        raise SignatureError("timestamp outside tolerance")
    expected = hmac.new(secret.encode(), f"{t}.".encode() + body, hashlib.sha256).hexdigest()
    if not any(hmac.compare_digest(expected, s) for s in sigs):
        raise SignatureError("no matching signature")
    return t

--- hookrelay/transport.py ---
"""HTTP delivery of one webhook attempt and classification of the outcome."""

import http.client
import socket
import ssl
from dataclasses import dataclass
from urllib.parse import urlsplit

from .signing import sign

USER_AGENT = "hookrelay/1.4"


@dataclass(frozen=True)
class AttemptResult:
    outcome: str            # "delivered" | "retryable" | "permanent"
    status: int | None
    error: str = ""
    retry_after: int | None = None


def _retry_after(raw: str | None) -> int | None:
    if raw is None:
        return None
    try:
        value = int(raw.strip())
    except ValueError:
        return None  # HTTP-date form is not supported
    return value if value >= 0 else None


def classify(status: int, headers: dict) -> AttemptResult:
    if 200 <= status < 300:
        return AttemptResult("delivered", status)
    if status in (408, 425, 429) or status >= 500:
        return AttemptResult("retryable", status, f"HTTP {status}",
                             _retry_after(headers.get("retry-after")))
    return AttemptResult("permanent", status, f"HTTP {status}")


def _connection(url: str, timeout: float):
    parts = urlsplit(url)
    if parts.scheme == "https":
        ctx = ssl.create_default_context()
        return http.client.HTTPSConnection(parts.hostname, parts.port or 443, timeout=timeout,
                                           context=ctx), parts
    if parts.scheme == "http":
        return http.client.HTTPConnection(parts.hostname, parts.port or 80, timeout=timeout), parts
    raise ValueError(f"unsupported scheme in {url!r}")


def post(url: str, body: bytes, secret: str, *, event_id: str, timeout: float = 10.0) -> AttemptResult:
    try:
        conn, parts = _connection(url, timeout)
    except ValueError as exc:
        return AttemptResult("permanent", None, str(exc))
    path = parts.path or "/"
    if parts.query:
        path += "?" + parts.query
    headers = {
        "Content-Type": "application/json",
        "User-Agent": USER_AGENT,
        "X-Hookrelay-Event": event_id,
        "X-Hookrelay-Signature": sign(secret, body),
    }
    try:
        conn.request("POST", path, body=body, headers=headers)
        resp = conn.getresponse()
        resp.read(65536)
        hdrs = {k.lower(): v for k, v in resp.getheaders()}
        return classify(resp.status, hdrs)
    except socket.timeout:
        return AttemptResult("retryable", None, "timeout")
    except ssl.SSLCertVerificationError as exc:
        return AttemptResult("permanent", None, f"tls: {exc.verify_message}")
    except (ConnectionError, OSError) as exc:
        return AttemptResult("retryable", None, f"connection: {exc}")
    except http.client.HTTPException as exc:
        return AttemptResult("retryable", None, f"protocol: {exc!r}")
    finally:
        conn.close()

--- tests/conftest.py ---
import pytest

from hookrelay.outbox import Outbox
from hookrelay.transport import AttemptResult


class Clock:
    def __init__(self, t=1_800_000_000.0):
        self.t = t

    def __call__(self):
        return self.t


class FakeSend:
    """Replays scripted AttemptResults and records calls."""

    def __init__(self, *results):
        self.results = list(results)
        self.calls = []

    def __call__(self, url, body, secret, *, event_id, timeout):
        self.calls.append((url, event_id))
        return self.results.pop(0) if self.results else AttemptResult("delivered", 200)


@pytest.fixture
def clock():
    return Clock()


@pytest.fixture
def outbox(tmp_path, clock):
    return Outbox(str(tmp_path / "o.db"), clock=clock)

--- tests/test_config.py ---
import pytest

from hookrelay.config import ConfigError, load


def test_defaults():
    s = load({})
    assert s.db == "/app/var/outbox.db" and s.timeout == 10.0 and s.batch == 100


def test_overrides_and_secret(tmp_path):
    key = tmp_path / "k"
    key.write_text("abc\n")
    s = load({"HOOKRELAY_DB": "x.db", "HOOKRELAY_SECRET_FILE": str(key),
              "HOOKRELAY_TIMEOUT": "2.5", "HOOKRELAY_BATCH": "7"})
    assert (s.db, s.timeout, s.batch, s.secret()) == ("x.db", 2.5, 7, "abc")


@pytest.mark.parametrize("env", [{"HOOKRELAY_TIMEOUT": "fast"}, {"HOOKRELAY_BATCH": "0"},
                                 {"HOOKRELAY_BATCH": "1.5"}])
def test_invalid_numbers(env):
    with pytest.raises(ConfigError):
        load(env)


def test_secret_errors(tmp_path):
    with pytest.raises(ConfigError):
        load({"HOOKRELAY_SECRET_FILE": str(tmp_path / "missing")}).secret()
    (tmp_path / "empty").write_text("\n")
    with pytest.raises(ConfigError):
        load({"HOOKRELAY_SECRET_FILE": str(tmp_path / "empty")}).secret()

--- tests/test_outbox_dispatch.py ---
import json

import pytest

from hookrelay import cli
from hookrelay.dispatcher import Dispatcher
from hookrelay.transport import AttemptResult, classify

from conftest import FakeSend


def test_enqueue_is_idempotent(outbox):
    assert outbox.enqueue("ev1", "http://a/hook", b"{}")
    assert outbox.enqueue("ev1", "http://a/hook", b"{}") is None
    assert outbox.enqueue("ev1", "http://b/hook", b"{}")
    assert outbox.counts() == {"pending": 2}


def test_due_respects_next_attempt(outbox, clock):
    did = outbox.enqueue("ev1", "http://a/hook", b"{}")
    outbox.update(did, next_attempt_at=clock.t + 60)
    assert outbox.due() == []
    clock.t += 60
    assert [r["id"] for r in outbox.due()] == [did]


def test_delivers_due(outbox):
    did = outbox.enqueue("ev1", "http://a/hook", b"{}")
    send = FakeSend(AttemptResult("delivered", 200))
    stats = Dispatcher(outbox, "k", send=send).run_once()
    assert stats.as_dict()["delivered"] == 1
    row = outbox.get(did)
    assert (row["status"], row["attempts"]) == ("delivered", 1)
    assert send.calls == [("http://a/hook", "ev1")]


def test_failure_is_recorded(outbox):
    did = outbox.enqueue("ev1", "http://a/hook", b"{}")
    Dispatcher(outbox, "k", send=FakeSend(AttemptResult("permanent", 404, "HTTP 404"))).run_once()
    assert outbox.get(did)["last_error"] == "HTTP 404"


@pytest.mark.parametrize("status,outcome", [(200, "delivered"), (204, "delivered"), (500, "retryable"),
                                            (503, "retryable"), (429, "retryable"), (408, "retryable"),
                                            (400, "permanent"), (404, "permanent"), (410, "permanent")])
def test_classify(status, outcome):
    assert classify(status, {}).outcome == outcome


def test_retry_after_seconds():
    assert classify(429, {"retry-after": "120"}).retry_after == 120
    assert classify(503, {"retry-after": "Wed, 21 Oct 2026 07:28:00 GMT"}).retry_after is None
    assert classify(503, {"retry-after": "-5"}).retry_after is None


def test_cli_enqueue_and_status(tmp_path, monkeypatch, capsys):
    monkeypatch.setattr(cli, "DB", str(tmp_path / "o.db"))
    body = tmp_path / "b.json"
    body.write_text("{}")
    cli.main(["enqueue", "ev9", "http://a/hook", str(body)])
    cli.main(["enqueue", "ev9", "http://a/hook", str(body)])
    cli.main(["status"])
    out = capsys.readouterr().out.strip().splitlines()
    assert out[1].startswith("duplicate")
    assert json.loads(out[-1]) == {"pending": 1}

--- tests/test_signing.py ---
import pytest

from hookrelay.signing import SignatureError, parse_header, sign, verify


def test_roundtrip():
    h = sign("s3cret", b'{"a":1}', timestamp=1000)
    assert verify("s3cret", b'{"a":1}', h, now=1010) == 1000


def test_wrong_secret_or_body():
    h = sign("s3cret", b"x", timestamp=1000)
    with pytest.raises(SignatureError):
        verify("other", b"x", h, now=1000)
    with pytest.raises(SignatureError):
        verify("s3cret", b"y", h, now=1000)


def test_tolerance():
    h = sign("k", b"x", timestamp=1000)
    with pytest.raises(SignatureError):
        verify("k", b"x", h, now=1000 + 301)


def test_multiple_signatures_any_matches():
    good = sign("k", b"x", timestamp=5).split("v1=")[1]
    assert verify("k", b"x", f"t=5,v1=deadbeef,v1={good}", now=5) == 5


@pytest.mark.parametrize("header", ["", "t=abc,v1=00", "v1=00", "t=5"])
def test_malformed(header):
    with pytest.raises(SignatureError):
        parse_header(header)


def test_sign_defaults_to_now():
    assert sign("k", b"x").startswith("t=")

--- tests/test_transport_http.py ---
import threading
from http.server import BaseHTTPRequestHandler, HTTPServer

import pytest

from hookrelay.signing import verify
from hookrelay.transport import post


class Receiver(BaseHTTPRequestHandler):
    responses = []
    seen = []

    def do_POST(self):
        body = self.rfile.read(int(self.headers["Content-Length"]))
        Receiver.seen.append((self.path, dict(self.headers), body))
        status, headers = Receiver.responses.pop(0)
        self.send_response(status)
        for k, v in headers.items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(b"ok")

    def log_message(self, *args):
        pass


@pytest.fixture
def server():
    httpd = HTTPServer(("127.0.0.1", 0), Receiver)
    t = threading.Thread(target=httpd.serve_forever, daemon=True)
    t.start()
    Receiver.responses, Receiver.seen = [], []
    yield f"http://127.0.0.1:{httpd.server_address[1]}"
    httpd.shutdown()


def test_post_signs_and_delivers(server):
    Receiver.responses.append((200, {}))
    res = post(server + "/hook?src=test", b'{"a":1}', "k", event_id="ev1")
    assert res.outcome == "delivered"
    path, headers, body = Receiver.seen[0]
    assert path == "/hook?src=test" and body == b'{"a":1}'
    assert headers["X-Hookrelay-Event"] == "ev1"
    verify("k", body, headers["X-Hookrelay-Signature"])


def test_post_retryable_with_retry_after(server):
    Receiver.responses.append((503, {"Retry-After": "90"}))
    res = post(server, b"{}", "k", event_id="ev2")
    assert (res.outcome, res.status, res.retry_after) == ("retryable", 503, 90)


def test_post_rejects_unknown_scheme():
    assert post("ftp://example/x", b"{}", "k", event_id="e").outcome == "permanent"

