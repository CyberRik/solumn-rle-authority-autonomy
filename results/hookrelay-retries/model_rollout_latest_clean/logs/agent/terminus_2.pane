@pytest.mark.parametrize("max_attempts", [1, 2, 8])
def test_retry_exhaustion(outbox, clock, max_attempts):
    did = outbox.enqueue("event", "http://a/hook", b"{}")
    send = FakeSend(*(AttemptResult("retryable", None, "timeout") for _ in range(max_attempts)))
    # Also exercise the documented default of 8, not just the override.
    kwargs = {} if max_attempts == 8 else {"max_attempts": max_attempts}
    dispatcher = Dispatcher(outbox, "k", send=send, **kwargs)
    for attempt in range(1, max_attempts + 1):
        now = clock.t
        stats = dispatcher.run_once().as_dict()
        row = outbox.get(did)
        assert row["attempts"] == attempt
        assert row["last_error"] == "timeout"
        if attempt < max_attempts:
            assert stats == {"delivered": 0, "retried": 1, "dead": 0}
            assert row["status"] == "pending"
            assert row["next_attempt_at"] == now + backoff_delay("event", attempt)
            assert outbox.dead_letters() == []
            clock.t = row["next_attempt_at"]
        else:
            assert stats == {"delivered": 0, "retried": 0, "dead": 1}
            assert row["status"] == "dead"
    assert [dict(r) for r in outbox.dead_letters()] == [{
        "delivery_id": did, "event_id": "event", "endpoint": "http://a/hook",
        "attempts": max_attempts, "reason": "max attempts: timeout", "at": clock.t,
    }]
    clock.t += 100000
    assert dispatcher.run_once().as_dict() == {"delivered": 0, "retried": 0, "dead": 0}
    assert len(send.calls) [?2004h> 
