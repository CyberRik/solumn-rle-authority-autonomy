[?2004l"""Backfill worker.

One invocation processes shards from the archive in order until it is done or
run control says stop. Shards are restored in bounded ranges; each range
commits its position and lossless aggregate together before checking run control.
"""

import json
import logging
import os
import signal
import time
import tomllib
from dataclasses import dataclass
from pathlib import Path

import coldstore

from .aggregate import Aggregator
from .checkpoint import Checkpoint
from .control import RunControl, load_control

log = logging.getLogger("backfill")

# About 0.45s per restore with the archive client: comfortably within the
# host's SIGTERM grace period, including aggregation and checkpoint writes.
RANGE_LINES = 1000


@dataclass(frozen=True)
class JobConfig:
    backfill_id: str
    source: Path
    report: Path
    state: Path


def load_job(root: Path) -> JobConfig:
    with (Path(root) / "backfill.toml").open("rb") as fh:
        doc = tomllib.load(fh)
    job = doc["job"]

    def rel(p):
        p = Path(p)
        return p if p.is_absolute() else Path(root) / p

    return JobConfig(job["id"], rel(job["source"]), rel(job["report"]), rel(job.get("state", "state")))


def _record_run(job: JobConfig, entry: dict) -> None:
    job.state.mkdir(parents=True, exist_ok=True)
    with (job.state / "runs.jsonl").open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(entry) + "\n")


def write_report(job: JobConfig, agg: Aggregator, shards: list[str]) -> None:
    report = agg.report()
    report["backfill"] = job.backfill_id
    report["shards"] = len(shards)
    job.report.parent.mkdir(parents=True, exist_ok=True)
    tmp = job.report.with_suffix(".tmp")
    tmp.write_text(json.dumps(report, indent=1, sort_keys=True), encoding="utf-8")
    os.replace(tmp, job.report)


def run(root: Path) -> int:
    """Returns 0 when complete, 3 when stopped; every committed range is resumable."""
    root = Path(root)
    job = load_job(root)
    control = RunControl(load_control(root))
    handlers = {sig: signal.getsignal(sig) for sig in (signal.SIGTERM, signal.SIGINT)}
    control.install_signal_handlers()
    try:
        return _run(job, control)
    finally:
        for sig, handler in handlers.items():
            signal.signal(sig, handler)


def _run(job: JobConfig, control: RunControl) -> int:
    ckpt = Checkpoint(job.state / "checkpoint.json", job.backfill_id)
    shards = sorted(coldstore.list_objects(job.source))
    saved = ckpt.load_state()
    completed = set(saved["completed"]) if saved else set()
    offsets = dict(saved["offsets"]) if saved else {}
    agg = Aggregator.from_state(saved["aggregate"]) if saved else Aggregator()
    done_now: list[str] = []
    started = time.time()
    stop_reason = control.should_stop()

    for name in shards:
        if stop_reason:
            break
        if name in completed:
            continue
        path = job.source / name
        total = coldstore.stat(path)["lines"]
        offset = offsets.get(name, 0)
        if not 0 <= offset <= total:
            raise ValueError(f"invalid checkpoint offset for {name}: {offset}/{total}")
        while offset < total:
            stop_reason = control.should_stop()
            if stop_reason:
                break
            count = min(RANGE_LINES, total - offset)
            lines = coldstore.restore_range(path, offset, count)
            if len(lines) != count:
                raise coldstore.RestoreError(f"short restore for {name} at {offset}")
            agg.add_lines(lines)
            offset += len(lines)
            offsets[name] = offset
            if offset == total:
                completed.add(name)
                offsets.pop(name)
            ckpt.save(completed, offsets=offsets, aggregate=agg.to_state())
            log.info("shard %s: %d/%d lines (%.1fs elapsed)",
                     name, offset, total, control.elapsed)
        if stop_reason:
            break
        if name not in completed:  # Empty shard: no restore required.
            completed.add(name)
            offsets.pop(name, None)
            ckpt.save(completed, offsets=offsets, aggregate=agg.to_state())
        done_now.append(name)
        stop_reason = control.should_stop()

    entry = {"started": started, "elapsed": round(control.elapsed, 2), "processed": done_now,
             "stopped": stop_reason, "pid": os.getpid()}
    _record_run(job, entry)
    if stop_reason:
        log.warning("stopping: %s (%d shards this run)", stop_reason, len(done_now))
        return 3

    write_report(job, agg, shards)
    log.info("backfill %s complete: %d shards", job.backfill_id, len(shards))
    return 0


def status(root: Path) -> dict:
    job = load_job(root)
    shards = coldstore.list_objects(job.source)
    saved = Checkpoint(job.state / "checkpoint.json", job.backfill_id).load_state()
    completed = set(saved["completed"]) if saved else set()
    return {"backfill": job.backfill_id, "shards": len(shards),
            "completed": len(completed & set(shards)),
            "offsets": saved["offsets"] if saved else {}, "report": str(job.report),
            "report_exists": job.report.exists()}
[?2004hroot@791e3126620a:/app# sed -n '55,130p' backfill/aggregate.py
[?2004l
    def add_lines(self, lines) -> None:
        for line in lines:
            if line.strip():
                self.add_line(line)

    def to_state(self) -> dict:
        """Lossless checkpoint state; distinct-user counts alone cannot be merged."""
        return {
            "events": self.events,
            "rejected": self.rejected,
            "days": {
                day: {"counts": dict(stats.counts),
                      "revenue_cents": stats.revenue_cents,
                      "users": sorted(stats.users)}
                for day, stats in self.days.items()
            },
        }

    @classmethod
    def from_state(cls, state: dict) -> "Aggregator":
        agg = cls()
        agg.events = state["events"]
        agg.rejected = state["rejected"]
        for day, stats in state["days"].items():
            agg.days[day] = DayStats(dict(stats["counts"]), stats["revenue_cents"],
                                     set(stats["users"]))
        return agg

    def report(self) -> dict:
        days = {d: self.days[d].to_report() for d in sorted(self.days)}
        totals = {t: sum(v[t] for v in days.values()) for t in EVENT_TYPES}
        totals["revenue_cents"] = sum(v["revenue_cents"] for v in days.values())
        totals["unique_users"] = len(set().union(*(s.users for s in self.days.values())))
        return {"days": days, "totals": totals, "events": self.events, "rejected": self.rejected}
