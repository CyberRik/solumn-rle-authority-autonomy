def test_multiple_stopped_runs_preserve_exact_totals(make_root, monkeypatch):
    import coldstore
    from backfill.runner import status

    root = make_root({
        "s3.jsonl.gz": [ev(2, "b", "purchase", 700), ev(1, "c"), "invalid", ""],
        "s1.jsonl.gz": [ev(1, "a"), ev(1, "a", "purchase", 100), "invalid"],
        "s2.jsonl.gz": [ev(1, "a", "add_to_cart"), ev(1, "b", "purchase", 250), ev(2, "a")],
    })
    original = coldstore.restore
    restored = []

    def stop_after_shard(path):
        restored.append(path.name)
        lines = original(path)
        (root / "ops/STOP").touch()
        return lines

    monkeypatch.setattr(coldstore, "restore", stop_after_shard)
    for count in (1, 2):
        assert run(root) == 3
        assert status(root)["completed"] == count
        assert not (root / "out/report.json").exists()
        (root / "ops/STOP").unlink()
    # A stop during the final shard can still publish a complete report.
    assert run(root) == 0
    assert restored == ["s1.jsonl.gz", "s2.jsonl.gz", "s3.jsonl.gz"]
    rep = json.loads((root / "out/report.json").read_text())
    assert rep == {
        "bac[?2004h> 
