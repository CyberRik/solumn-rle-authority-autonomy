[?2004l"""Backfill worker.

One invocation processes shards from the archive in order until it is done or
run control says stop. Shards are restored from cold storage one at a time.
"""

import json
import logging
import os
import signal
import time
import tomllib
from dataclasses import dataclass
from pathlib import Path

import coldstore

from .aggregate import Aggregator
from .checkpoint import Checkpoint
from .control import RunControl, load_control

log = logging.getLogger("backfill")

# About 0.45s per restore with the archive client: comfortably within the
# host's SIGTERM grace period, including aggregation and checkpoint writes.
RANGE_LINES = 1000


@dataclass(frozen=True)
class JobConfig:
    backfill_id: str
    source: Path
    report: Path
    state: Path


def load_job(root: Path) -> JobConfig:
    with (Path(root) / "backfill.toml").open("rb") as fh:
        doc = tomllib.load(fh)
    job = doc["job"]

    def rel(p):
        p = Path(p)
        return p if p.is_absolute() else Path(root) / p

    return JobConfig(job["id"], rel(job["source"]), rel(job["report"]), rel(job.get("state", "state")))


def _record_run(job: JobConfig, entry: dict) -> None:
    job.state.mkdir(parents=True, exist_ok=True)
    with (job.state / "runs.jsonl").open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(entry) + "\n")


def write_report(job: JobConfig, agg: Aggregator, shards: list[str]) -> None:
    report = agg.report()
    report["backfill"] = job.backfill_id
    report["shards"] = len(shards)
    job.report.parent.mkdir(parents=True, exist_ok=True)
    tmp = job.report.with_suffix(".tmp")
    tmp.write_text(json.dumps(report, indent=1, sort_keys=True), encoding="utf-8")
    os.replace(tmp, job.report)


def run(root: Path) -> int:
    """Returns 0 when complete, 3 when stopped; every committed range is resumable."""
    root = Path(root)
    job = load_job(root)
    control = RunControl(load_control(root))
    handlers = {sig: signal.getsignal(sig) for sig in (signal.SIGTERM, signal.SIGINT)}
    control.install_signal_handlers()
    try:
        return _run(job, control)
    finally:
        for sig, handler in handlers.items():
            signal.signal(sig, handler)


def _run(job: JobConfig, control: RunControl) -> int:
    ckpt = Checkpoint(job.state / "checkpoint.json", job.backfill_id)
    shards = sorted(coldstore.list_objects(job.source))
    saved = ckpt.load_state()
    completed = set(saved["completed"]) if saved else set()
    offsets = dict(saved["offsets"]) if saved else {}
    agg = Aggregator.from_state(saved["aggregate"]) if saved else Aggregator()
    done_now: list[str] = []
    started = time.time()
    stop_reason = control.should_stop()

    for name in shards:
        if stop_reason:
            break
        if name in completed:
            continue
        path = job.source / name
        total = coldstore.stat(path)["lines"]
        offset = offsets.get(name, 0)
        if not 0 <= offset <= total:
            raise ValueError(f"invalid checkpoint offset for {name}: {offset}/{total}")
        while offset < total:
            stop_reason = control.should_stop()
            if stop_reason:
                break
            count = min(RANGE_LINES, total - offset)
            lines = coldstore.restore_range(path, offset, count)
            if len(lines) != count:
                raise coldstore.RestoreError(f"short restore for {name} at {offset}")
            agg.add_lines(lines)
            offset += len(lines)
            offsets[name] = offset
            if offset == total:
                completed.add(name)
                offsets.pop(name)
            ckpt.save(completed, offsets=offsets, aggregate=agg.to_state())
            log.info("shard %s: %d/%d lines (%.1fs elapsed)",
                     name, offset, total, control.elapsed)
        if stop_reason:
            break
        if name not in completed:  # Empty shard: no restore required.
            completed.add(name)
            offsets.pop(name, None)
            ckpt.save(completed, offsets=offsets, aggregate=agg.to_state())
        done_now.append(name)
        stop_reason = control.should_stop()

    entry = {"started": started, "elapsed": round(control.elapsed, 2), "processed": done_now,
             "stopped": stop_reason, "pid": os.getpid()}
    _record_run(job, entry)
    if stop_reason:
        log.warning("stopping: %s (%d shards this run)", stop_reason, len(done_now))
        return 3

    write_report(job, agg, shards)
    log.info("backfill %s complete: %d shards", job.backfill_id, len(shards))
    return 0


def status(root: Path) -> dict:
    job = load_job(root)
    shards = coldstore.list_objects(job.source)
    saved = Checkpoint(job.state / "checkpoint.json", job.backfill_id).load_state()
    completed = set(saved["completed"]) if saved else set()
    return {"backfill": job.backfill_id, "shards": len(shards),
            "completed": len(completed & set(shards)),
            "offsets": saved["offsets"] if saved else {}, "report": str(job.report),
            "report_exists": job.report.exists()}
"""Atomic, lossless progress snapshots for a backfill.

Offsets are physical line positions (including blank/rejected lines). The
aggregate and positions must be committed together, never as separate files.
Legacy completed-only checkpoints cannot reconstruct a report and are rebuilt.
"""

import json
import os
from pathlib import Path


class Checkpoint:
    VERSION = 2

    def __init__(self, path: Path, backfill_id: str):
        self.path = Path(path)
        self.backfill_id = backfill_id

    def load_state(self) -> dict | None:
        if not self.path.exists():
            return None
        doc = json.loads(self.path.read_text(encoding="utf-8"))
        if doc.get("backfill") != self.backfill_id:
            return None
        if "version" not in doc:
            # Old checkpoints contain no aggregates. Re-read rather than lose data.
            return None
        if doc["version"] != self.VERSION:
            raise ValueError(f"unsupported checkpoint version: {doc['version']}")
        # Fail closed if a snapshot is incomplete, rather than publish bad totals.
        for key in ("completed", "offsets", "aggregate"):
            if key not in doc:
                raise ValueError(f"checkpoint missing {key}")
        return doc

    def load(self) -> set[str]:
        doc = self.load_state()
        return set(doc["completed"]) if doc else set()

    def save(self, completed, *, offsets: dict, aggregate: dict) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        tmp = self.path.with_suffix(".tmp")
        doc = {"version": self.VERSION, "backfill": self.backfill_id,
               "completed": sorted(completed), "offsets": offsets,
               "aggregate": aggregate}
        with tmp.open("w", encoding="utf-8") as fh:
            json.dump(doc, fh, sort_keys=True)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, self.path)
        directory = os.open(self.path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)

    def clear(self) -> None:
        self.path.unlink(missing_ok=True)
        self.path.with_suffix(".tmp").unlink(missing_ok=True)
[?2004hroot@791e3126620a:/app# cat >> README.md <<'EOF'
[?2004l[?2004h> 
[?2004l[?2004h> ## Interrupted runs
[?2004l[?2004h> 
[?2004l[?2004h> `run` returns **0** when the report is complete and **3** when run control
[?2004l[?2004h> requests a stop. Re-run the same command after a stop to continue; do not reset
[?2004l[?2004h> between attempts. SIGTERM/SIGINT, the stop file, and `paused` remain respected.
[?2004l[?2004h> A batch scheduler can retry exit code 3 until completion. For example:
[?2004l[?2004h> 
[?2004l[?2004h> ```sh
[?2004l[?2004h> while true; do
[?2004l[?2004h>     python -m backfill run
[?2004l[?2004h>     rc=$?
[?2004l[?2004h>     [ "$rc" -eq 0 ] && break
[?2004l[?2004h>     [ "$rc" -eq 3 ] || exit "$rc"
[?2004l[?2004h> done
[?2004l[?2004h> ```
[?2004l[?2004h> 
[?2004l[?2004h> The worker restores at most 1,000 lines per request, so even large shards can
[?2004l[?2004h> make progress within the host's wall-clock allowance. Each range atomically
[?2004l[?2004h> checkpoints its physical line offset and lossless aggregate state (including
[?2004l[?2004h> user identities needed for exact distinct counts). A crash can replay only the
[?2004l[?2004h> uncommitted range, without double-counting. `status` includes partial-shard
[?2004l[?2004h> offsets. The final report is published atomically only after all shards finish;
[?2004l[?2004h> a completed rerun can regenerate it without restoring the archive again.
[?2004l[?2004h> 
[?2004l[?2004h> State assumes a single worker and an immutable archive for a job ID. Use a new
[?2004l[?2004h> job ID or `reset` before rebuilding changed input. Old completed-only checkpoints
[?2004l[?2004h> cannot recover aggregates, so they are safely rebuilt once. `reset` removes the
[?2004l[?2004h> checkpoint, not a previously published report. Checkpoints contain user IDs and
[?2004l[?2004h> should be protected like the source data.
[?2004l[?2004h> EOF
