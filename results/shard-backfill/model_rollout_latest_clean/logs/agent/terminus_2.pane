def test_failed_replace_keeps_entire_previous_snapshot(tmp_path, monkeypatch):
    ckpt = Checkpoint(tmp_path / "checkpoint.json", "t")
    agg = Aggregator()
    agg.add_lines([ev(1, "a")])
    ckpt.save({"s1"}, agg)
    agg.add_lines([ev(1, "b", "purchase", 500)])

    def fail(*args):
        raise OSError("simulated crash before commit")

    with monkeypatch.context() as patch:
        patch.setattr("backfill.checkpoint.os.replace", fail)
        with pytest.raises(OSError):
            ckpt.save({"s1", "s2"}, agg)
    completed, loaded = ckpt.load_progress()
    assert completed == {"s1"}
    assert loaded.report()["events"] == 1
    assert loaded.report()["totals"]["revenue_cents"] == 0
    ckpt.save({"s1", "s2"}, agg)
    assert ckpt.load_progress()[1].report() == agg.report()


def test_legacy_names_only_checkpoint_is_not_trusted(tmp_path):
    path = tmp_path / "checkpoint.json"
    path.write_text(json.dumps({"backfill": "t", "completed": ["s1"]}))
    completed, agg = Checkpoint(path, "t").load_progress()
    assert completed == set()
    assert agg.report()["events"] == 0


def test_corrupt_or_unknown_checkpoint_fails_closed(tmp_path):
    path = tmp_path / "checkpoint.json"
    path.write_text('{"backfill":')
    with pytest.raises(json.JSONDecodeError):
        Checkpoint(path, "t").load()
    path.write_text('{"backfill":"t","version":999}')
    with pytest.raises(ValueError, match="unsupported"):
        Checkpoint(path, "t").load()
