import json

import pytest

import coldstore


@pytest.fixture(autouse=True)
def fast_archive(monkeypatch, tmp_path):
    monkeypatch.setattr(coldstore, "RESTORE_LATENCY_SEC", 0)
    monkeypatch.setattr(coldstore, "RESTORE_SEC_PER_KLINE", 0)
    monkeypatch.setattr(coldstore, "ACCESS_LOG", tmp_path / "access.log")
    monkeypatch.setattr(coldstore, "LEASES", tmp_path / "leases")


def ev(day, user, etype="view", amount=None):
    e = {"id": f"{day}-{user}-{etype}", "ts": f"2026-10-{day:02d}T10:00:00Z", "user": user, "type": etype}
    if amount is not None:
        e["amount_cents"] = amount
    return json.dumps(e)


@pytest.fixture
def make_root(tmp_path):
    def build(shards: dict[str, list[str]], paused=False):
        root = tmp_path / "root"
        src = tmp_path / "archive"
        (root / "ops").mkdir(parents=True)
        src.mkdir()
        for name, lines in shards.items():
            with gzip.open(src / name, "wt") as fh:
                fh.write("\n".join(lines) + "\n")
        (root / "backfill.toml").write_text(
            f'[job]\nid = "t"\nsource = "{src.as_posix()}"\nreport = "out/report.json"\n')
        (root / "ops/control.toml").write_text(
            '[control]\nstop_file = "ops/STOP"\npaused = ' + ("true" if paused else "false") + "\n")
        return root
    return build
from backfill.aggregate import Aggregator

from conftest import ev


def test_counts_revenue_and_unique_users():
    agg = Aggregator()
    agg.add_lines([ev(1, "a"), ev(1, "a", "purchase", 500), ev(1, "b", "add_to_cart"), ev(2, "a")])
    rep = agg.report()
    assert rep["days"]["2026-10-01"] == {"view": 1, "add_to_cart": 1, "purchase": 1,
                                         "revenue_cents": 500, "unique_users": 2}
    assert rep["totals"]["unique_users"] == 2
    assert rep["events"] == 4


def test_rejects_bad_lines():
    agg = Aggregator()
    agg.add_lines(['{"ts": ', ev(1, "a", "refund"), ev(1, "a", "purchase", -5), ev(1, "a"), ""])
    rep = agg.report()
    assert rep["rejected"] == 3 and rep["events"] == 1
import os
import signal

from backfill.control import ControlConfig, RunControl


def test_stop_file_and_pause(tmp_path):
    c = RunControl(ControlConfig(tmp_path / "STOP", False))
    assert c.should_stop() is None
    (tmp_path / "STOP").touch()
    assert "stop file" in c.should_stop()
    p = RunControl(ControlConfig(tmp_path / "x" / "STOP", True))
    assert "paused" in p.should_stop()


def test_sigterm_requests_stop(tmp_path):
    c = RunControl(ControlConfig(tmp_path / "STOP", False))
    old = signal.getsignal(signal.SIGTERM)
    try:
        c.install_signal_handlers()
        os.kill(os.getpid(), signal.SIGTERM)
        assert c.should_stop() == "received SIGTERM"
    finally:
        signal.signal(signal.SIGTERM, old)
        signal.signal(signal.SIGINT, signal.default_int_handler)
import json

from backfill.runner import run

from conftest import ev


def test_single_run_completes(make_root):
    root = make_root({"s1.jsonl.gz": [ev(1, "a"), ev(2, "b")], "s2.jsonl.gz": [ev(1, "b", "purchase", 100)]})
    assert run(root) == 0
    rep = json.loads((root / "out/report.json").read_text())
    assert rep["shards"] == 2 and rep["events"] == 3
    assert rep["days"]["2026-10-01"]["unique_users"] == 2


def test_stop_file_stops_before_work(make_root):
    root = make_root({"s1.jsonl.gz": [ev(1, "a")]})
    (root / "ops/STOP").touch()
    assert run(root) == 3
    assert not (root / "out/report.json").exists()


def test_paused_does_nothing(make_root):
    root = make_root({"s1.jsonl.gz": [ev(1, "a")]}, paused=True)
    assert run(root) == 3
