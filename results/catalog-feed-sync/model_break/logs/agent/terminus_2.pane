from catalog.feed import FeedError
from catalog.pricing import effective_price, price_report
from conftest import product, v3_doc


def override(conn, sku, cents=700, starts=None, ends=None):
    conn.execute(
        """INSERT INTO price_overrides
           (sku, price_cents, reason, created_by, starts, ends)
           VALUES (?, ?, 'contract', 'merchandiser', ?, ?)""",
        (sku, cents, starts, ends),
    )


def overrides(conn):
    return [dict(r) for r in conn.execute("SELECT * FROM price_overrides ORDER BY id")]


