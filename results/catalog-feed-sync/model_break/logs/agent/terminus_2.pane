[?2004l"""Parsing of supplier catalog feeds into normalised FeedItems.

Suppliers drop their feeds on our SFTP host; the nightly job mirrors the drop
directory to /srv/supplier-drop/<supplier>/. Each supplier's integration docs
live with the supplier; we only keep the parsers here.

Supported formats:
    catalog/v2  -- {"supplier", "format", "generated", "items": [...]}
"""

import json
from dataclasses import dataclass
from decimal import Decimal, InvalidOperation
from pathlib import Path


class FeedError(Exception):
    """The feed is malformed or in a format we do not understand."""


class UnsupportedFormat(FeedError):
    pass


@dataclass(frozen=True)
class FeedItem:
    sku: str
    name: str
    price_cents: int
    currency: str
    lifecycle: str
    previous_sku: str | None = None


@dataclass(frozen=True)
class Feed:
    supplier: str
    format: str
    generated: str
    items: tuple[FeedItem, ...]
    skipped: tuple[str, ...] = ()


V2_STATUS = {"active": "active", "discontinued": "discontinued"}


def _price_to_cents(raw, where: str) -> int:
    try:
        value = Decimal(str(raw))
    except InvalidOperation as exc:
        raise FeedError(f"{where}: bad price {raw!r}") from exc
    if value < 0:
        raise FeedError(f"{where}: negative price {raw!r}")
    cents = (value * 100).quantize(Decimal("1"))
    if cents != value * 100:
        raise FeedError(f"{where}: price {raw!r} has sub-cent precision")
    return int(cents)


def _parse_v2(doc: dict) -> Feed:
    supplier = doc.get("supplier")
    if not supplier:
        raise FeedError("v2 feed without supplier")
    items, skipped, seen = [], [], set()
    for i, raw in enumerate(doc.get("items", [])):
        where = f"items[{i}]"
        sku = (raw.get("sku") or "").strip()
        if not sku:
            raise FeedError(f"{where}: missing sku")
        if sku in seen:
            raise FeedError(f"{where}: duplicate sku {sku}")
        seen.add(sku)
        if raw.get("currency", "USD") != "USD":
            skipped.append(sku)
            continue
        status = V2_STATUS.get(raw.get("status", "active"))
        if status is None:
            raise FeedError(f"{where}: unknown status {raw.get('status')!r}")
        items.append(
            FeedItem(
                sku=sku,
                name=raw["title"].strip(),
                price_cents=_price_to_cents(raw["price"], where),
                currency="USD",
                lifecycle=status,
            )
        )
    return Feed(supplier, "catalog/v2", doc.get("generated", ""), tuple(items), tuple(skipped))


def detect_format(doc: dict) -> str:
    if "format" in doc:
        return doc["format"]
    meta = doc.get("_meta")
    if isinstance(meta, dict) and "schema" in meta:
        return meta["schema"]
    raise FeedError("cannot determine feed format")


PARSERS = {
    "catalog/v2": _parse_v2,
}


def parse_feed(doc: dict) -> Feed:
    fmt = detect_format(doc)
    parser = PARSERS.get(fmt)
    if parser is None:
        raise UnsupportedFormat(f"unsupported feed format {fmt!r}")
    return parser(doc)


def load_feed(path: str | Path) -> Feed:
    with open(path, encoding="utf-8") as fh:
        return parse_feed(json.load(fh))


def latest_drop(drop_root: str | Path, supplier: str) -> Path:
    """Most recent feed file a supplier has dropped (lexicographic on name)."""
    folder = Path(drop_root) / supplier
    files = sorted(p for p in folder.glob("*.json") if p.is_file())
    if not files:
        raise FeedError(f"no feed files in {folder}")
    return files[-1]
"""Apply a parsed supplier feed to the catalog database.

A sync is all-or-nothing: the products a supplier sends are upserted, and
products of that supplier that are no longer in the feed are pruned. If any
step fails the whole run is rolled back and recorded as failed.
"""

import logging
from dataclasses import dataclass

from . import db
from .feed import Feed

log = logging.getLogger("catalog.sync")


@dataclass
class SyncResult:
    supplier: str
    upserted: int
    pruned: int
    skipped: int


def _record_run(conn, supplier, fmt, started, upserted, pruned, status):
    conn.execute(
        """INSERT INTO sync_runs
               (supplier, feed_format, started_at, finished_at, upserted, pruned, status)
           VALUES (?, ?, ?, ?, ?, ?, ?)""",
        (supplier, fmt, started, db.utcnow(), upserted, pruned, status),
    )
    conn.commit()


def apply_feed(conn, feed: Feed, *, prune: bool = True) -> SyncResult:
    started = db.utcnow()
    try:
        with db.transaction(conn):
            existing = db.supplier_skus(conn, feed.supplier)
            seen = set()
            for item in feed.items:
                db.upsert_product(
                    conn,
                    sku=item.sku,
                    supplier=feed.supplier,
                    name=item.name,
                    list_price_cents=item.price_cents,
                    lifecycle=item.lifecycle,
                )
                seen.add(item.sku)
            stale = existing - seen
            pruned = db.delete_products(conn, stale) if prune else 0
    except Exception:
        log.exception("sync of %s failed; rolled back", feed.supplier)
        _record_run(conn, feed.supplier, feed.format, started, 0, 0, "failed")
        raise
    _record_run(conn, feed.supplier, feed.format, started, len(seen), pruned, "ok")
    log.info("%s: upserted=%d pruned=%d skipped=%d",
             feed.supplier, len(seen), pruned, len(feed.skipped))
    return SyncResult(feed.supplier, len(seen), pruned, len(feed.skipped))
"""Effective (customer-facing) prices.

The storefront price of a product is its supplier list price unless a
merchandiser override is in effect on the given day. When several overrides
overlap, the lowest price wins (that is what the price-match policy says).
Discontinued products are not sold and have no effective price.
"""

import csv
import io
from datetime import date


def _in_window(override, day: str) -> bool:
    starts, ends = override["starts"], override["ends"]
    if starts and day < starts:
        return False
    if ends and day > ends:
        return False
    return True


def effective_price(conn, sku: str, day: str | None = None) -> int | None:
    day = day or date.today().isoformat()
    row = conn.execute(
        "SELECT list_price_cents, lifecycle FROM products WHERE sku = ?", (sku,)
    ).fetchone()
    if row is None:
        raise KeyError(sku)
    if row["lifecycle"] == "discontinued":
        return None
    price = row["list_price_cents"]
    for ov in conn.execute("SELECT * FROM price_overrides WHERE sku = ?", (sku,)):
        if _in_window(ov, day):
            price = min(price, ov["price_cents"])
    return price


def price_report(conn, supplier: str | None = None, day: str | None = None) -> str:
    """CSV of every product with list and effective price, sorted by sku."""
    query = "SELECT sku, supplier, name, list_price_cents, lifecycle FROM products"
    params: tuple = ()
    if supplier:
        query += " WHERE supplier = ?"
        params = (supplier,)
    out = io.StringIO()
    writer = csv.writer(out, lineterminator="\n")
    writer.writerow(["sku", "supplier", "name", "lifecycle", "list_cents", "effective_cents"])
    for row in conn.execute(query + " ORDER BY sku", params):
        eff = effective_price(conn, row["sku"], day)
        writer.writerow([row["sku"], row["supplier"], row["name"], row["lifecycle"],
                         row["list_price_cents"], "" if eff is None else eff])
    return out.getvalue()
"""SQLite storage for the merchandising catalog.

Products are keyed by the supplier's SKU. Merchandisers attach price
overrides (promotions, contract pricing, price matches) to products.
"""

import sqlite3
from contextlib import contextmanager
from datetime import datetime, timezone

SCHEMA = """
CREATE TABLE IF NOT EXISTS products (
    sku              TEXT PRIMARY KEY,
    supplier         TEXT NOT NULL,
    name             TEXT NOT NULL,
    list_price_cents INTEGER NOT NULL CHECK (list_price_cents >= 0),
    lifecycle        TEXT NOT NULL DEFAULT 'active',
    updated_at       TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS price_overrides (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    sku         TEXT NOT NULL
                REFERENCES products(sku) ON DELETE RESTRICT,
    price_cents INTEGER NOT NULL CHECK (price_cents >= 0),
    reason      TEXT NOT NULL,
    created_by  TEXT NOT NULL,
    starts      TEXT,
    ends        TEXT
);

CREATE TABLE IF NOT EXISTS sync_runs (
    id           INTEGER PRIMARY KEY AUTOINCREMENT,
    supplier     TEXT NOT NULL,
    feed_format  TEXT NOT NULL,
    started_at   TEXT NOT NULL,
    finished_at  TEXT,
    upserted     INTEGER NOT NULL DEFAULT 0,
    pruned       INTEGER NOT NULL DEFAULT 0,
    status       TEXT NOT NULL DEFAULT 'running'
);
"""

LIFECYCLES = ("active", "preorder", "discontinued")


def utcnow() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def connect(path: str) -> sqlite3.Connection:
    conn = sqlite3.connect(path, isolation_level=None)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    conn.executescript(SCHEMA)
    return conn


@contextmanager
def transaction(conn: sqlite3.Connection):
    """Run a block atomically; roll back everything on any exception."""
    conn.execute("BEGIN")
    try:
        yield conn
    except BaseException:
        conn.execute("ROLLBACK")
        raise
    else:
        conn.execute("COMMIT")


def supplier_skus(conn: sqlite3.Connection, supplier: str) -> set[str]:
    rows = conn.execute("SELECT sku FROM products WHERE supplier = ?", (supplier,))
    return {r["sku"] for r in rows}


def upsert_product(conn, *, sku, supplier, name, list_price_cents, lifecycle):
    if lifecycle not in LIFECYCLES:
        raise ValueError(f"unknown lifecycle {lifecycle!r} for {sku}")
    conn.execute(
        """
        INSERT INTO products (sku, supplier, name, list_price_cents, lifecycle, updated_at)
        VALUES (?, ?, ?, ?, ?, ?)
        ON CONFLICT(sku) DO UPDATE SET
            name = excluded.name,
            list_price_cents = excluded.list_price_cents,
            lifecycle = excluded.lifecycle,
            updated_at = excluded.updated_at
        WHERE products.supplier = excluded.supplier
        """,
        (sku, supplier, name, list_price_cents, lifecycle, utcnow()),
    )


def delete_products(conn, skus) -> int:
    n = 0
    for sku in sorted(skus):
        n += conn.execute("DELETE FROM products WHERE sku = ?", (sku,)).rowcount
    return n


def overrides_for(conn, sku: str):
    return conn.execute(
        "SELECT * FROM price_overrides WHERE sku = ? ORDER BY id", (sku,)
    ).fetchall()
"""Command line entry points.

    python -m catalog sync   --supplier acme [--feed FILE] [--db PATH]
    python -m catalog report [--supplier acme] [--day YYYY-MM-DD] [--db PATH]
    python -m catalog runs   [--db PATH]
"""

import argparse
import logging
import os
import sys

import acme_feedkit

from . import db
from .feed import FeedError, latest_drop, load_feed
from .pricing import price_report
from .sync import apply_feed

DEFAULT_DB = os.environ.get("CATALOG_DB", "/app/data/catalog.db")
DROP_ROOT = os.environ.get("SUPPLIER_DROP", "/srv/supplier-drop")


def cmd_sync(args) -> int:
    path = args.feed
    if path is None:
        path = latest_drop(DROP_ROOT, args.supplier)
        try:
            acme_feedkit.verify_drop(path)
        except acme_feedkit.DropIntegrityError as exc:
            raise FeedError(str(exc)) from exc
    feed = load_feed(path)
    if feed.supplier != args.supplier:
        print(f"feed {path} is for {feed.supplier!r}, not {args.supplier!r}", file=sys.stderr)
        return 2
    conn = db.connect(args.db)
    res = apply_feed(conn, feed, prune=not args.no_prune)
    print(f"{res.supplier}: upserted {res.upserted}, pruned {res.pruned}, skipped {res.skipped}"
          f" ({feed.format}, {path})")
    return 0


def cmd_report(args) -> int:
    conn = db.connect(args.db)
    sys.stdout.write(price_report(conn, args.supplier, args.day))
    return 0


def cmd_runs(args) -> int:
    conn = db.connect(args.db)
    for r in conn.execute("SELECT * FROM sync_runs ORDER BY id"):
        print(f"{r['id']:>4} {r['supplier']:<12} {r['feed_format']:<12} {r['status']:<7}"
              f" up={r['upserted']} pruned={r['pruned']} {r['finished_at']}")
    return 0


def main(argv=None) -> int:
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(name)s: %(message)s")
    p = argparse.ArgumentParser(prog="catalog")
    p.add_argument("--db", default=DEFAULT_DB)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("sync")
    s.add_argument("--supplier", required=True)
    s.add_argument("--feed")
    s.add_argument("--no-prune", action="store_true")
    s.set_defaults(fn=cmd_sync)

    r = sub.add_parser("report")
    r.add_argument("--supplier")
    r.add_argument("--day")
    r.set_defaults(fn=cmd_report)

    sub.add_parser("runs").set_defaults(fn=cmd_runs)

    args = p.parse_args(argv)
    try:
        return args.fn(args)
    except FeedError as exc:
        print(f"feed error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
