import pytest

from catalog.feed import FeedError, UnsupportedFormat, parse_feed

from conftest import item, v2_doc


def test_v2_parses_prices_to_cents():
    feed = parse_feed(v2_doc([item("A-1", price="12.5"), item("A-2", price="0.99")]))
    assert [i.price_cents for i in feed.items] == [1250, 99]
    assert feed.supplier == "acme" and feed.format == "catalog/v2"


def test_v2_skips_non_usd_rows():
    feed = parse_feed(v2_doc([item("A-1"), item("A-2", currency="EUR")]))
    assert [i.sku for i in feed.items] == ["A-1"]
    assert feed.skipped == ("A-2",)


def test_v2_maps_status_to_lifecycle():
    feed = parse_feed(v2_doc([item("A-1", status="discontinued")]))
    assert feed.items[0].lifecycle == "discontinued"


@pytest.mark.parametrize("bad", ["-1", "abc", "1.005"])
def test_v2_rejects_bad_prices(bad):
    with pytest.raises(FeedError):
        parse_feed(v2_doc([item("A-1", price=bad)]))


def test_v2_rejects_duplicate_skus():
    with pytest.raises(FeedError):
        parse_feed(v2_doc([item("A-1"), item("A-1")]))


def test_unknown_format_is_rejected():
    with pytest.raises(UnsupportedFormat):
        parse_feed({"format": "catalog/v9", "items": []})
from catalog.feed import parse_feed
from catalog.pricing import effective_price, price_report
from catalog.sync import apply_feed

from conftest import item, v2_doc


def add_override(conn, sku, cents, starts=None, ends=None):
    conn.execute("INSERT INTO price_overrides (sku, price_cents, reason, created_by, starts, ends)"
                 " VALUES (?, ?, 'test', 'tester', ?, ?)", (sku, cents, starts, ends))


def test_list_price_without_override(conn):
    apply_feed(conn, parse_feed(v2_doc([item("A-1", price="10.00")])))
    assert effective_price(conn, "A-1", "2026-11-20") == 1000


def test_lowest_active_override_wins(conn):
    apply_feed(conn, parse_feed(v2_doc([item("A-1", price="10.00")])))
    add_override(conn, "A-1", 900)
    add_override(conn, "A-1", 700, "2026-11-27", "2026-11-30")
    assert effective_price(conn, "A-1", "2026-11-20") == 900
    assert effective_price(conn, "A-1", "2026-11-28") == 700
    assert effective_price(conn, "A-1", "2026-12-01") == 900


def test_discontinued_has_no_price(conn):
    apply_feed(conn, parse_feed(v2_doc([item("A-1", status="discontinued")])))
    assert effective_price(conn, "A-1") is None


def test_report_lists_effective_prices(conn):
    apply_feed(conn, parse_feed(v2_doc([item("A-1", price="10.00"), item("A-2", price="5.00")])))
    add_override(conn, "A-2", 450)
    lines = price_report(conn, "acme", "2026-11-20").splitlines()
    assert lines[0].startswith("sku,")
    assert lines[1].endswith(",1000,1000")
    assert lines[2].endswith(",500,450")
import pytest

from catalog import db

from catalog.feed import parse_feed
from catalog.sync import apply_feed

from conftest import item, v2_doc


def skus(conn):
    return [r["sku"] for r in conn.execute("SELECT sku FROM products ORDER BY sku")]


def test_sync_inserts_and_updates(conn):
    apply_feed(conn, parse_feed(v2_doc([item("A-1", price="1.00"), item("A-2")])))
    apply_feed(conn, parse_feed(v2_doc([item("A-1", price="2.00"), item("A-2")])))
    row = conn.execute("SELECT list_price_cents FROM products WHERE sku='A-1'").fetchone()
    assert row[0] == 200
    assert skus(conn) == ["A-1", "A-2"]


def test_sync_prunes_products_dropped_from_feed(conn):
    apply_feed(conn, parse_feed(v2_doc([item("A-1"), item("A-2")])))
    res = apply_feed(conn, parse_feed(v2_doc([item("A-1")])))
    assert res.pruned == 1
    assert skus(conn) == ["A-1"]


def test_prune_is_scoped_to_supplier(conn):
    apply_feed(conn, parse_feed(v2_doc([item("B-1")], supplier="other")))
    apply_feed(conn, parse_feed(v2_doc([item("A-1")])))
    apply_feed(conn, parse_feed(v2_doc([item("A-2")])))
    assert skus(conn) == ["A-2", "B-1"]


def test_failed_sync_rolls_back(conn, monkeypatch):
    apply_feed(conn, parse_feed(v2_doc([item("A-1"), item("A-2")])))

    def boom(conn, skus):
        raise RuntimeError("disk full")

    monkeypatch.setattr(db, "delete_products", boom)
    with pytest.raises(RuntimeError):
        apply_feed(conn, parse_feed(v2_doc([item("A-1", price="3.00")])))
    row = conn.execute("SELECT list_price_cents FROM products WHERE sku='A-1'").fetchone()
    assert row[0] == 1000
    assert skus(conn) == ["A-1", "A-2"]
    last = conn.execute("SELECT status FROM sync_runs ORDER BY id DESC LIMIT 1").fetchone()
    assert last[0] == "failed"
