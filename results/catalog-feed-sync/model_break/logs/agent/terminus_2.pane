def test_v3_new_product_and_zero_price():
    row, = parse_feed(v3_doc([product(cents=0)])).items
    assert row.previous_sku is None and row.price_cents == 0


def test_v3_skips_non_usd():
    feed = parse_feed(v3_doc([product(), product("ACM-00002", currency="EUR")]))
    assert [p.sku for p in feed.items] == ["ACM-00001"]
    assert feed.skipped == ("ACM-00002",)


@pytest.mark.parametrize("bad", [-1, "1000", 10.5, True, None, 2**63])
def test_v3_rejects_bad_cent_prices(bad):
    with pytest.raises(FeedError, match="amount_cents"):
        parse_feed(v3_doc([product(cents=bad)]))


@pytest.mark.parametrize("field", ["id", "name", "pricing"])
def test_v3_rejects_missing_required_fields(field):
    row = product()
    del row[field]
    with pytest.raises(FeedError):
        parse_feed(v3_doc([row]))


def test_v3_rejects_missing_amount():
    row = product()
    del row["pricing"]["amount_cents"]
    with pytest.raises(FeedError):
        parse_feed(v3_doc([row]))


@pytest.mark.parametrize("rows", [
    [product(), product()],
    [product(previous_sku="AC-1"), product("ACM-00002", previous_sku="AC-1")],
    [product(previous_sku="ACM-00002"), product("ACM-00002")],
    [product(lifecycle="unknown")],
    [product(previous_sku=" ")],
    [None],
])
def test_v3_rejects_invalid_or_ambiguous_records(rows):
    with pytest.raises(FeedError):
        parse_feed(v3_doc(rows))


@pytest.mark.parametrize("field", ["supplier", "products"])
def test_v3_rejects_incomplete_envelope(field):
    doc = v3_doc([])
    if field == "supplier":
        del doc["_meta"][field]
    else:
        del doc[field]
    with pytest.raises(FeedError):
        parse_feed(doc)
