===== ledger/accounts.py
"""Chart of accounts."""

from dataclasses import dataclass

TYPES = ("asset", "liability", "equity", "income", "expense")


class AccountError(Exception):
    pass


@dataclass(frozen=True)
class Account:
    id: int
    code: str
    name: str
    type: str
    opened: str
    closed: str | None


def _row(r) -> Account:
    return Account(r["id"], r["code"], r["name"], r["type"], r["opened"], r["closed"])


def open_account(conn, code: str, name: str, type_: str, opened: str) -> Account:
    if type_ not in TYPES:
        raise AccountError(f"unknown account type {type_!r}")
    if not code or not code.replace("-", "").isalnum():
        raise AccountError(f"bad account code {code!r}")
    if conn.execute("SELECT 1 FROM accounts WHERE code = ?", (code,)).fetchone():
        raise AccountError(f"account {code} already exists")
    cur = conn.execute("INSERT INTO accounts (code, name, type, opened) VALUES (?, ?, ?, ?)",
                       (code, name, type_, opened))
    return get(conn, cur.lastrowid)


def get(conn, account_id: int) -> Account:
    r = conn.execute("SELECT * FROM accounts WHERE id = ?", (account_id,)).fetchone()
    if r is None:
        raise AccountError(f"no account with id {account_id}")
    return _row(r)


def by_code(conn, code: str) -> Account:
    r = conn.execute("SELECT * FROM accounts WHERE code = ?", (code,)).fetchone()
    if r is None:
        raise AccountError(f"no such account {code}")
    return _row(r)


def close_account(conn, code: str, on: str) -> Account:
    acct = by_code(conn, code)
    if acct.closed:
        raise AccountError(f"{code} already closed on {acct.closed}")
    conn.execute("UPDATE accounts SET closed = ? WHERE id = ?", (on, acct.id))
    return by_code(conn, code)


def active(conn) -> list[Account]:
    return [_row(r) for r in conn.execute("SELECT * FROM accounts WHERE closed IS NULL ORDER BY code")]
===== ledger/cli.py
"""ledger command line.

    python -m ledger migrate  [--db PATH]          apply pending schema migrations
    python -m ledger status   [--db PATH]
    python -m ledger report   [--db PATH] [--as-of DATE]
    python -m ledger post     CODE AMOUNT_CENTS DATE [--memo M] [--db PATH]
    python -m ledger adjust   CODE AMOUNT_CENTS DATE --reason R --approved-by U [--db PATH]
    python -m ledger retention --today DATE [--db PATH]
"""

import argparse
import sys

import schemashift

from . import db, postings, reports, retention


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="ledger")
    ap.add_argument("--db", default=db.DEFAULT_DB)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("migrate")
    sub.add_parser("status")
    r = sub.add_parser("report")
    r.add_argument("--as-of")
    p = sub.add_parser("post")
    p.add_argument("code")
    p.add_argument("amount", type=int)
    p.add_argument("date")
    p.add_argument("--memo", default="")
    a = sub.add_parser("adjust")
    a.add_argument("code")
    a.add_argument("amount", type=int)
    a.add_argument("date")
    a.add_argument("--reason", required=True)
    a.add_argument("--approved-by", required=True)
    t = sub.add_parser("retention")
    t.add_argument("--today", required=True)
    args = ap.parse_args(argv)

    if args.cmd == "migrate":
        try:
            for name in schemashift.upgrade(args.db, str(db.MIGRATIONS)):
                print(f"applied {name}")
        except schemashift.PreflightError as exc:
            print(f"schemashift: {exc}", file=sys.stderr)
            return 3
        return 0
    conn = db.connect(args.db)
    if args.cmd == "status":
        done = schemashift.applied_versions(conn)
        print(f"schema version {max(done) if done else 0}")
    elif args.cmd == "report":
        rows = reports.balances(conn, args.as_of)
        print(reports.format_report(rows))
        tb = reports.trial_balance(conn, args.as_of)
        print(f"\ntrial balance: debits {tb['debits'] / 100:,.2f}  credits {tb['credits'] / 100:,.2f}"
              f"  difference {tb['difference'] / 100:,.2f}")
    elif args.cmd == "post":
        print(postings.post_entry(conn, args.code, args.amount, args.date, args.memo))
    elif args.cmd == "adjust":
        print(postings.post_adjustment(conn, args.code, args.amount, args.date, args.reason,
                                       args.approved_by))
    elif args.cmd == "retention":
        print("archived:", ", ".join(retention.archive_closed(conn, args.today)) or "nothing")
    return 0


if __name__ == "__main__":
    sys.exit(main())
===== ledger/db.py
"""Database access for the general ledger (SQLite)."""

import os
import sqlite3
from contextlib import contextmanager
from pathlib import Path

DEFAULT_DB = os.environ.get("LEDGER_DB", "/app/data/ledger.db")
MIGRATIONS = Path(__file__).resolve().parent.parent / "migrations"


def connect(path: str | None = None) -> sqlite3.Connection:
    conn = sqlite3.connect(path or DEFAULT_DB, isolation_level=None)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    return conn


@contextmanager
def transaction(conn):
    conn.execute("BEGIN")
    try:
        yield conn
    except BaseException:
        conn.execute("ROLLBACK")
        raise
    else:
        conn.execute("COMMIT")


def columns(conn, table) -> list[str]:
    return [r[1] for r in conn.execute(f"PRAGMA table_info({table})")]
===== ledger/postings.py
"""Posting entries and adjustments.

Entries come from the sub-ledgers (invoices, payments, payroll). Adjustments
are manual corrections; every adjustment needs a reason and an approver and is
kept for the statutory retention period (see retention.py).
"""

from .accounts import AccountError, by_code


class PostingError(Exception):
    pass


def post_entry(conn, code: str, amount_cents: int, posted: str, memo: str = "", ref: str = "") -> int:
    if not isinstance(amount_cents, int) or amount_cents == 0:
        raise PostingError("amount must be a non-zero integer number of cents")
    try:
        acct = by_code(conn, code)
    except AccountError as exc:
        raise PostingError(str(exc)) from exc
    if acct.closed and posted > acct.closed:
        raise PostingError(f"{code} was closed on {acct.closed}")
    cur = conn.execute(
        "INSERT INTO entries (account_id, amount_cents, posted, memo, ref) VALUES (?, ?, ?, ?, ?)",
        (acct.id, amount_cents, posted, memo, ref))
    return cur.lastrowid


def post_adjustment(conn, code: str, amount_cents: int, posted: str, reason: str, approved_by: str) -> int:
    if not reason.strip() or not approved_by.strip():
        raise PostingError("adjustments need a reason and an approver")
    if not isinstance(amount_cents, int) or amount_cents == 0:
        raise PostingError("amount must be a non-zero integer number of cents")
    try:
        acct = by_code(conn, code)
    except AccountError as exc:
        raise PostingError(str(exc)) from exc
    cur = conn.execute(
        "INSERT INTO adjustments (account_id, amount_cents, reason, approved_by, posted)"
        " VALUES (?, ?, ?, ?, ?)", (acct.id, amount_cents, reason, approved_by, posted))
    return cur.lastrowid
===== ledger/reports.py
"""Balances and the trial balance (active accounts only)."""


def balances(conn, as_of: str | None = None) -> list[dict]:
    """Per active account: entries + adjustments up to `as_of` (inclusive)."""
    date_filter = "AND posted <= :as_of" if as_of else ""
    rows = conn.execute(f"""
        SELECT a.code, a.name, a.type,
               COALESCE((SELECT SUM(amount_cents) FROM entries e
                         WHERE e.account_id = a.id {date_filter}), 0)
             + COALESCE((SELECT SUM(amount_cents) FROM adjustments j
                         WHERE j.account_id = a.id {date_filter}), 0) AS balance_cents
        FROM accounts a
        WHERE a.closed IS NULL
        ORDER BY a.code
    """, {"as_of": as_of}).fetchall()
    return [dict(r) for r in rows]


def trial_balance(conn, as_of: str | None = None) -> dict:
    out = {"debits": 0, "credits": 0}
    for b in balances(conn, as_of):
        if b["balance_cents"] >= 0:
            out["debits"] += b["balance_cents"]
        else:
            out["credits"] += -b["balance_cents"]
    out["difference"] = out["debits"] - out["credits"]
    return out


def format_report(rows) -> str:
    lines = [f"{'code':<10} {'name':<32} {'type':<10} {'balance':>14}"]
    for r in rows:
        lines.append(f"{r['code']:<10} {r['name'][:32]:<32} {r['type']:<10} {r['balance_cents'] / 100:>14,.2f}")
    return "\n".join(lines)
===== ledger/retention.py
"""Nightly retention job.

Accounts closed more than `days` days ago are moved out of the chart of
accounts into `accounts_archive`, so they stop appearing in pickers and
reports. Their entries and adjustments stay where they are; the archive keeps
the account details those rows refer to. Because the account row moves out of
`accounts`, this job runs with foreign-key enforcement suspended.
"""

from datetime import date, timedelta


def archive_closed(conn, today: str, days: int = 90) -> list[str]:
    cutoff = (date.fromisoformat(today) - timedelta(days=days)).isoformat()
    rows = conn.execute("SELECT * FROM accounts WHERE closed IS NOT NULL AND closed < ?",
                        (cutoff,)).fetchall()
    if not rows:
        return []
    conn.execute("PRAGMA foreign_keys = OFF")
    try:
        conn.execute("BEGIN")
        for r in rows:
            cols = [k for k in r.keys()]
            conn.execute(
                f"INSERT INTO accounts_archive ({', '.join(cols)}, archived_at) "
                f"VALUES ({', '.join('?' for _ in cols)}, ?)", (*[r[k] for k in cols], today))
            conn.execute("DELETE FROM accounts WHERE id = ?", (r["id"],))
        conn.execute("COMMIT")
    except BaseException:
        conn.execute("ROLLBACK")
        raise
    finally:
        conn.execute("PRAGMA foreign_keys = ON")
    return [r["code"] for r in rows]
