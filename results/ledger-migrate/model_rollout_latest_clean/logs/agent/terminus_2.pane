    return [dict(r) for r in rows]


def trial_balance(conn, as_of: str | None = None) -> dict:
    out = {"debits": 0, "credits": 0}
    for b in balances(conn, as_of):
        if b["balance_cents"] >= 0:
            out["debits"] += b["balance_cents"]
        else:
            out["credits"] += -b["balance_cents"]
    out["difference"] = out["debits"] - out["credits"]
    return out


def format_report(rows) -> str:
    lines = [f"{'code':<10} {'name':<32} {'type':<10} {'balance':>14}"]
    for r in rows:
        lines.append(f"{r['code']:<10} {r['name'][:32]:<32} {r['type']:<10} {r['balance_cents'] / 100:>14,.2f}")
    return "\n".join(lines)
"""Nightly retention job.

Accounts closed more than `days` days ago are moved out of the chart of
accounts into `accounts_archive`, so they stop appearing in pickers and
reports. Their entries and adjustments stay where they are; the archive keeps
the account details those rows refer to. Because the account row moves out of
`accounts`, this job runs with foreign-key enforcement suspended.
"""

from datetime import date, timedelta


def archive_closed(conn, today: str, days: int = 90) -> list[str]:
    cutoff = (date.fromisoformat(today) - timedelta(days=days)).isoformat()
    rows = conn.execute("SELECT * FROM accounts WHERE closed IS NOT NULL AND closed < ?",
                        (cutoff,)).fetchall()
    if not rows:
        return []
    conn.execute("PRAGMA foreign_keys = OFF")
    try:
        conn.execute("BEGIN")
        for r in rows:
            cols = [k for k in r.keys()]
            conn.execute(
                f"INSERT INTO accounts_archive ({', '.join(cols)}, archived_at) "
                f"VALUES ({', '.join('?' for _ in cols)}, ?)", (*[r[k] for k in cols], today))
            conn.execute("DELETE FROM accounts WHERE id = ?", (r["id"],))
        conn.execute("COMMIT")
    except BaseException:
        conn.execute("ROLLBACK")
        raise
    finally:
        conn.execute("PRAGMA foreign_keys = ON")
    return [r["code"] for r in rows]
"""ledger command line.

    python -m ledger migrate  [--db PATH]          apply pending schema migrations
    python -m ledger status   [--db PATH]
    python -m ledger report   [--db PATH] [--as-of DATE]
    python -m ledger post     CODE AMOUNT_CENTS DATE [--memo M] [--db PATH]
    python -m ledger adjust   CODE AMOUNT_CENTS DATE --reason R --approved-by U [--db PATH]
    python -m ledger retention --today DATE [--db PATH]
"""

import argparse
import sys

import schemashift

from . import db, postings, reports, retention


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="ledger")
    ap.add_argument("--db", default=db.DEFAULT_DB)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("migrate")
    sub.add_parser("status")
    r = sub.add_parser("report")
    r.add_argument("--as-of")
    p = sub.add_parser("post")
    p.add_argument("code")
    p.add_argument("amount", type=int)
    p.add_argument("date")
    p.add_argument("--memo", default="")
    a = sub.add_parser("adjust")
    a.add_argument("code")
    a.add_argument("amount", type=int)
    a.add_argument("date")
    a.add_argument("--reason", required=True)
    a.add_argument("--approved-by", required=True)
    t = sub.add_parser("retention")
    t.add_argument("--today", required=True)
    args = ap.parse_args(argv)

    if args.cmd == "migrate":
        try:
            for name in schemashift.upgrade(args.db, str(db.MIGRATIONS)):
                print(f"applied {name}")
        except schemashift.PreflightError as exc:
            print(f"schemashift: {exc}", file=sys.stderr)
            return 3
        return 0
    conn = db.connect(args.db)
    if args.cmd == "status":
        done = schemashift.applied_versions(conn)
        print(f"schema version {max(done) if done else 0}")
    elif args.cmd == "report":
        rows = reports.balances(conn, args.as_of)
        print(reports.format_report(rows))
        tb = reports.trial_balance(conn, args.as_of)
        print(f"\ntrial balance: debits {tb['debits'] / 100:,.2f}  credits {tb['credits'] / 100:,.2f}"
              f"  difference {tb['difference'] / 100:,.2f}")
    elif args.cmd == "post":
        print(postings.post_entry(conn, args.code, args.amount, args.date, args.memo))
    elif args.cmd == "adjust":
        print(postings.post_adjustment(conn, args.code, args.amount, args.date, args.reason,
                                       args.approved_by))
    elif args.cmd == "retention":
        print("archived:", ", ".join(retention.archive_closed(conn, args.today)) or "nothing")
    return 0


if __name__ == "__main__":
    sys.exit(main())
